composition KEMHandlesGame {
    /* Assumption games for the KEM: one package, four switches. */

    types {
        Pk,
        Sk,
        Ctxt,
        Shk,
        KgenRand,
        EncRand,
    }

    const b_correct:  Bool;
    const b_coll:     Bool;
    const b_ind:      Bool;
    const b_lazy:     Bool;
    const kem_kgen:   fn KgenRand -> (Pk, Sk);
    const kem_encaps: fn EncRand, Pk -> (Ctxt, Shk);
    const kem_decaps: fn Sk, Ctxt -> Shk;

    instance KEMHandles = KEMHandles {
        types {
            Pk:       Pk,
            Sk:       Sk,
            Ctxt:     Ctxt,
            Shk:      Shk,
            KgenRand: KgenRand,
            EncRand:  EncRand,
        }
        params {
            b_correct:  b_correct,
            b_coll:     b_coll,
            b_ind:      b_ind,
            b_lazy:     b_lazy,
            kem_kgen:   kem_kgen,
            kem_encaps: kem_encaps,
            kem_decaps: kem_decaps,
        }
    }

    compose {
        adversary: {
            KEM_Gen:    KEMHandles,
            KEM_Encaps: KEMHandles,
            KEM_Decaps: KEMHandles,
            KEM_Get:    KEMHandles,
        },
    }
}
