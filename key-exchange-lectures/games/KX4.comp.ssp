composition KX4 {
    /*
     * Game KX_IV^b for Protocol IV.
     *
     *   adversary --> Model4 --> Prot4 --> KEM
     *
     * b = false: Test returns the real session key.
     * b = true : Test returns a random key.
     */

    types {
        Psk,
        Pk,
        Sk,
        Ctxt,
        Shk,
        Tag,
        KgenRand,
        EncRand,
    }

    const b:          Bool;
    const mac:        fn Psk, (Pk, Ctxt, Maybe(Tag)) -> Tag;
    const kem_kgen:   fn KgenRand -> (Pk, Sk);
    const kem_encaps: fn EncRand, Pk -> (Ctxt, Shk);
    const kem_decaps: fn Sk, Ctxt -> Shk;

    instance Model4 = Model4 {
        types {
            Psk:   Psk,
            Msg1:  Pk,
            Msg2:  (Ctxt, Tag),
            Msg3:  Tag,
            Key:   Shk,
            Other: (Maybe(Sk), Maybe(Shk)),
        }
        params {
            b: b,
        }
    }

    instance Prot4 = Prot4 {
        types {
            Psk:  Psk,
            Pk:   Pk,
            Sk:   Sk,
            Ctxt: Ctxt,
            Shk:  Shk,
            Tag:  Tag,
        }
        params {
            mac: mac,
        }
    }

    instance KEM = KEM {
        types {
            Pk:       Pk,
            Sk:       Sk,
            Ctxt:     Ctxt,
            Shk:      Shk,
            KgenRand: KgenRand,
            EncRand:  EncRand,
        }
        params {
            kem_kgen:   kem_kgen,
            kem_encaps: kem_encaps,
            kem_decaps: kem_decaps,
        }
    }

    compose {
        adversary: {
            NewKey:     Model4,
            Corrupt:    Model4,
            NewSession: Model4,
            Send1:      Model4,
            Send2:      Model4,
            Send3:      Model4,
            Send4:      Model4,
            Reveal:     Model4,
            Test:       Model4,
        },
        Model4: {
            Run1: Prot4,
            Run2: Prot4,
            Run3: Prot4,
            Run4: Prot4,
        },
        Prot4: {
            KEM_Gen:    KEM,
            KEM_Encaps: KEM,
            KEM_Decaps: KEM,
        },
    }
}
