composition Model4Security_Hybrid {
    /*
     * The hybrid games of Model4Security.
     *
     *   adversary --> Model4Modular --> Prot4Modular --> MACMultiKey, KEMHandles
     *
     * b is the Test bit, the other booleans switch the assumption packages.
     */

    types {
        Psk,
        Pk,
        Sk,
        Ctxt,
        Shk,
        Tag,
        KgenRand,
        EncRand,
    }

    const b:          Bool;
    const b_correct:  Bool;
    const b_coll:     Bool;
    const b_mac:      Bool;
    const b_ind:      Bool;
    const b_lazy:     Bool;
    const mac:        fn Psk, (Pk, Ctxt, Maybe(Tag)) -> Tag;
    const kem_kgen:   fn KgenRand -> (Pk, Sk);
    const kem_encaps: fn EncRand, Pk -> (Ctxt, Shk);
    const kem_decaps: fn Sk, Ctxt -> Shk;

    instance Model4Modular = Model4Modular {
        types {
            Psk:  Psk,
            Pk:   Pk,
            Ctxt: Ctxt,
            Tag:  Tag,
            Shk:  Shk,
        }
        params {
            b: b,
        }
    }

    instance Prot4Modular = Prot4Modular {
        types {
            Pk:   Pk,
            Ctxt: Ctxt,
            Tag:  Tag,
        }
    }

    instance MACMultiKey = MACMultiKey {
        types {
            Psk: Psk,
            Msg: (Pk, Ctxt, Maybe(Tag)),
            Tag: Tag,
        }
        params {
            b_mac: b_mac,
            mac:   mac,
        }
    }

    instance KEMHandles = KEMHandles {
        types {
            Pk:       Pk,
            Sk:       Sk,
            Ctxt:     Ctxt,
            Shk:      Shk,
            KgenRand: KgenRand,
            EncRand:  EncRand,
        }
        params {
            b_correct:  b_correct,
            b_coll:     b_coll,
            b_ind:      b_ind,
            b_lazy:     b_lazy,
            kem_kgen:   kem_kgen,
            kem_encaps: kem_encaps,
            kem_decaps: kem_decaps,
        }
    }

    compose {
        adversary: {
            NewKey:     Model4Modular,
            Corrupt:    Model4Modular,
            NewSession: Model4Modular,
            Send1:      Model4Modular,
            Send2:      Model4Modular,
            Send3:      Model4Modular,
            Send4:      Model4Modular,
            Reveal:     Model4Modular,
            Test:       Model4Modular,
        },
        Model4Modular: {
            MAC_Gen:     MACMultiKey,
            MAC_Corrupt: MACMultiKey,
            KEM_Get:     KEMHandles,
            Run1:        Prot4Modular,
            Run2:        Prot4Modular,
            Run3:        Prot4Modular,
            Run4:        Prot4Modular,
        },
        Prot4Modular: {
            MAC_Mac:    MACMultiKey,
            MAC_Verify: MACMultiKey,
            KEM_Gen:    KEMHandles,
            KEM_Encaps: KEMHandles,
            KEM_Decaps: KEMHandles,
        },
    }
}
