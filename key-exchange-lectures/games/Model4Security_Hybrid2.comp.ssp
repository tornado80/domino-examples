composition Model4Security_Hybrid2 {
    /*
     Hybrids of Model4Security around the assumption KEMLazy.

       Model4Modular --> Prot4Modular --> KEMReductionLazy --> KeyLazy

     b is the Test bit. The MAC is ideal.
     */

    types {
        Psk,
        Pk,
        Sk,
        Ctxt,
        Shk,
        Tag,
        KgenRand,
        EncRand,
    }

    const b: Bool;
    const b_lazy: Bool;
    const mac:        fn Psk, (Pk, Ctxt, Maybe(Tag)) -> Tag;
    const kem_kgen:   fn KgenRand -> (Pk, Sk);
    const kem_encaps: fn EncRand, Pk -> (Ctxt, Shk);
    const kem_decaps: fn Sk, Ctxt -> Shk;

    instance Model4Modular = Model4Modular {
        types {
            Psk:  Psk,
            Pk:   Pk,
            Ctxt: Ctxt,
            Tag:  Tag,
            Shk:  Shk,
        }
        params {
            b: b,
        }
    }

    instance Prot4Modular = Prot4Modular {
        types {
            Pk:   Pk,
            Ctxt: Ctxt,
            Tag:  Tag,
        }
    }

    instance MACMultiKey = MACMultiKey {
        types {
            Psk: Psk,
            Msg: (Pk, Ctxt, Maybe(Tag)),
            Tag: Tag,
        }
        params {
            b_mac: true,
            mac:   mac,
        }
    }

    instance KEMReductionLazy = KEMReductionLazy {
        types {
            Pk: Pk,
            Sk: Sk,
            Ctxt: Ctxt,
            Shk: Shk,
            KgenRand: KgenRand,
            EncRand: EncRand,
        }
        params {
            kem_kgen: kem_kgen,
            kem_encaps: kem_encaps,
            kem_decaps: kem_decaps,
        }
    }

    instance KeyLazy = KeyLazy {
        types {
            Shk: Shk,
        }
        params {
            b_lazy: b_lazy,
        }
    }

    compose {
        adversary: {
            NewKey:     Model4Modular,
            Corrupt:    Model4Modular,
            NewSession: Model4Modular,
            Send1:      Model4Modular,
            Send2:      Model4Modular,
            Send3:      Model4Modular,
            Send4:      Model4Modular,
            Reveal:     Model4Modular,
            Test:       Model4Modular,
        },
        Model4Modular: {
            MAC_Gen:     MACMultiKey,
            MAC_Corrupt: MACMultiKey,
            KEM_Get:     KEMReductionLazy,
            Run1:        Prot4Modular,
            Run2:        Prot4Modular,
            Run3:        Prot4Modular,
            Run4:        Prot4Modular,
        },
        Prot4Modular: {
            MAC_Mac:    MACMultiKey,
            MAC_Verify: MACMultiKey,
            KEM_Gen:    KEMReductionLazy,
            KEM_Encaps: KEMReductionLazy,
            KEM_Decaps: KEMReductionLazy,
        },
        KEMReductionLazy: {
            Lazy_Init: KeyLazy,
            Lazy_Get: KeyLazy,
        },
    }
}
