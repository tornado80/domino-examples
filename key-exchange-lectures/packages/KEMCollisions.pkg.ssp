package KEMCollisions {
    /*
     * Assumption KEMCollisions: key generation never returns a public key that
     * was already used, and encapsulation to an honest public key never
     * repeats a ciphertext for that key. With b_coll, the game aborts instead.
     */

    types {
        Pk,
        Sk,
        Ctxt,
        Shk,
        KgenRand,
        EncRand,
    }

    params {
        b_coll:     Bool,
        kem_kgen:   fn KgenRand -> (Pk, Sk),
        kem_encaps: fn EncRand, Pk -> (Ctxt, Shk),
    }

    state {
        UsedPk: Table(Pk, ()),
        Hon:    Table(Pk, ()),
        UsedCt: Table((Pk, Ctxt), ()),
    }

    oracle Coll_Gen() -> (Pk, Sk) {
        r <-$ KgenRand sample-name kem_kgen;
        (pk, sk) <- parse kem_kgen(r);
        if b_coll {
            assert (UsedPk[pk] == None);
        }
        UsedPk[pk] <- Some(());
        Hon[pk] <- Some(());
        return (pk, sk);
    }

    /* Records a public key that later key generations must avoid. */
    oracle Coll_Mark(pk: Pk) {
        UsedPk[pk] <- Some(());
    }

    oracle Coll_Encaps(pk: Pk) -> (Ctxt, Shk) {
        assert not (Hon[pk] == None);
        r <-$ EncRand sample-name kem_encaps;
        (c, shk) <- parse kem_encaps(r, pk);
        if b_coll {
            assert (UsedCt[(pk, c)] == None);
        }
        UsedCt[(pk, c)] <- Some(());
        return (c, shk);
    }
}
