package KEMCollisions {
    /*
     * Assumption KEMCollisions: key generation never returns a public key that
     * an earlier Gen returned or that was already passed to Encaps, and
     * encapsulation to a generated public key never repeats a ciphertext for
     * that key. With b_coll, the game aborts instead.
     */

    types {
        Pk,
        Sk,
        Ctxt,
        Shk,
        KgenRand,
        EncRand,
    }

    params {
        b_coll:     Bool,
        kem_kgen:   fn KgenRand -> (Pk, Sk),
        kem_encaps: fn EncRand, Pk -> (Ctxt, Shk),
    }

    state {
        UsedPk: Table(Pk, ()),
        Hon:    Table(Pk, ()),
        UsedCt: Table((Pk, Ctxt), ()),
    }

    oracle Coll_Gen() -> (Pk, Sk) {
        r <-$ KgenRand sample-name kem_kgen;
        (pk, sk) <- parse kem_kgen(r);
        if b_coll {
            assert (UsedPk[pk] == None);
        }
        UsedPk[pk] <- Some(());
        Hon[pk] <- Some(());
        return (pk, sk);
    }

    /* pk may be any public key, generated by Coll_Gen or not. */
    oracle Coll_Encaps(pk: Pk) -> (Ctxt, Shk) {
        r <-$ EncRand sample-name kem_encaps;
        (c, shk) <- parse kem_encaps(r, pk);
        if not (Hon[pk] == None) {
            if b_coll {
                assert (UsedCt[(pk, c)] == None);
            }
            UsedCt[(pk, c)] <- Some(());
        }
        UsedPk[pk] <- Some(());
        return (c, shk);
    }
}
