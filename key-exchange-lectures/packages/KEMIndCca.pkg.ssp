package KEMIndCca {
    /*
     * Assumption KEMIndCca: the lecture's game Gpind-cca for many public keys.
     * With b_ind, encapsulation returns a random key and decapsulation of that
     * ciphertext returns the same random key.
     */

    types {
        Pk,
        Sk,
        Ctxt,
        Shk,
        KgenRand,
        EncRand,
    }

    params {
        b_ind:      Bool,
        kem_kgen:   fn KgenRand -> (Pk, Sk),
        kem_encaps: fn EncRand, Pk -> (Ctxt, Shk),
        kem_decaps: fn Sk, Ctxt -> Shk,
    }

    state {
        SK: Table(Pk, Sk),
        T:  Table((Pk, Ctxt), Shk),
    }

    oracle Ind_Gen() -> Pk {
        r <-$ KgenRand sample-name kem_kgen;
        (pk, sk) <- parse kem_kgen(r);
        SK[pk] <- Some(sk);
        return pk;
    }

    oracle Ind_Encaps(pk: Pk) -> (Ctxt, Shk) {
        assert not (SK[pk] == None);
        r <-$ EncRand sample-name kem_encaps;
        (c, shk) <- parse kem_encaps(r, pk);
        if b_ind {
            k <-$ Shk sample-name ideal_key;
            T[(pk, c)] <- Some(k);
            return (c, k);
        }
        return (c, shk);
    }

    oracle Ind_Decaps(pk: Pk, c: Ctxt) -> Shk {
        sk <- Unwrap(SK[pk]);
        if (b_ind and not (T[(pk, c)] == None)) {
            return Unwrap(T[(pk, c)]);
        }
        return kem_decaps(sk, c);
    }
}
