package KEMIndCca {
    /*
     * Assumption KEMIndCca: the lecture's game Gpind-cca, indexed by a key
     * handle hk. With b_ind, encapsulation returns a random key and
     * decapsulation of that ciphertext returns the same random key.
     */

    types {
        Pk,
        Sk,
        Ctxt,
        Shk,
        KgenRand,
        EncRand,
    }

    params {
        b_ind:      Bool,
        kem_kgen:   fn KgenRand -> (Pk, Sk),
        kem_encaps: fn EncRand, Pk -> (Ctxt, Shk),
        kem_decaps: fn Sk, Ctxt -> Shk,
    }

    state {
        ctr: Integer,
        PK:  Table(Integer, Pk),
        SK:  Table(Integer, Sk),
        T:   Table((Integer, Ctxt), Shk),
    }

    oracle Ind_Gen() -> (Integer, Pk) {
        r <-$ KgenRand sample-name kem_kgen;
        (pk, sk) <- parse kem_kgen(r);
        ctr <- (ctr + 1);
        PK[ctr] <- Some(pk);
        SK[ctr] <- Some(sk);
        return (ctr, pk);
    }

    oracle Ind_Encaps(hk: Integer) -> (Ctxt, Shk) {
        pk <- Unwrap(PK[hk]);
        r <-$ EncRand sample-name kem_encaps;
        (c, shk) <- parse kem_encaps(r, pk);
        if b_ind {
            k <-$ Shk sample-name ideal_key;
            T[(hk, c)] <- Some(k);
            return (c, k);
        }
        return (c, shk);
    }

    oracle Ind_Decaps(hk: Integer, c: Ctxt) -> Shk {
        sk <- Unwrap(SK[hk]);
        if (b_ind and not (T[(hk, c)] == None)) {
            return Unwrap(T[(hk, c)]);
        }
        return kem_decaps(sk, c);
    }
}
