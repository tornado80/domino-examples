package KEMReductionCollisionsSk {
    /*
     * Reduction to KEMCollisions for protocols that keep their secret keys,
     * and so need no handle interface. Not an assumption: the equivalences
     * around it are proved.
     */

    types {
        Pk,
        Sk,
        Ctxt,
        Shk,
    }

    params {
        kem_decaps: fn Sk, Ctxt -> Shk,
    }

    import oracles {
        Coll_Gen() -> (Pk, Sk),
        Coll_Encaps(pk: Pk) -> (Ctxt, Shk),
    }

    oracle KEM_Gen() -> (Pk, Sk) {
        (pk, sk) <- parse invoke Coll_Gen();
        return (pk, sk);
    }

    oracle KEM_Encaps(pk: Pk) -> (Ctxt, Shk) {
        (c, shk) <- parse invoke Coll_Encaps(pk);
        return (c, shk);
    }

    oracle KEM_Decaps(sk: Sk, c: Ctxt) -> Shk {
        return kem_decaps(sk, c);
    }
}
