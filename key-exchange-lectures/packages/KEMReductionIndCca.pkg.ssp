package KEMReductionIndCca {
    /*
     * Reduction to KEMIndCca. Encapsulation to an honest public key goes
     * through the assumption, to any other public key it runs locally. The
     * collision aborts established by KEMCollisions stay here.
     * Not an assumption: the equivalences around it are proved.
     */

    types {
        Pk,
        Ctxt,
        Shk,
        EncRand,
    }

    params {
        kem_encaps: fn EncRand, Pk -> (Ctxt, Shk),
    }

    state {
        hk_ctr: Integer,
        h_ctr:  Integer,
        PK:     Table(Integer, Pk),
        Hon:    Table(Pk, ()),
        Seen:   Table(Pk, ()),
        HC:     Table((Pk, Ctxt), ()),
        Key:    Table(Integer, Shk),
        Valid:  Table(Integer, ()),
    }

    import oracles {
        Ind_Gen() -> Pk,
        Ind_Encaps(pk: Pk) -> (Ctxt, Shk),
        Ind_Decaps(pk: Pk, c: Ctxt) -> Shk,
    }

    oracle KEM_Gen() -> (Pk, Integer) {
        pk <- invoke Ind_Gen();
        assert (Hon[pk] == None);
        assert (Seen[pk] == None);
        hk_ctr <- (hk_ctr + 1);
        PK[hk_ctr] <- Some(pk);
        Hon[pk] <- Some(());
        return (pk, hk_ctr);
    }

    oracle KEM_Encaps(pk: Pk) -> (Ctxt, Integer) {
        h_ctr <- (h_ctr + 1);
        Valid[h_ctr] <- Some(());
        if not (Hon[pk] == None) {
            (c, shk) <- parse invoke Ind_Encaps(pk);
            assert (HC[(pk, c)] == None);
            HC[(pk, c)] <- Some(());
        } else {
            r <-$ EncRand sample-name kem_encaps;
            (c, shk) <- parse kem_encaps(r, pk);
        }
        Seen[pk] <- Some(());
        Key[h_ctr] <- Some(shk);
        return (c, h_ctr);
    }

    oracle KEM_Decaps(hk: Integer, c: Ctxt) -> Integer {
        pk <- Unwrap(PK[hk]);
        h_ctr <- (h_ctr + 1);
        Valid[h_ctr] <- Some(());
        shk <- invoke Ind_Decaps(pk, c);
        Key[h_ctr] <- Some(shk);
        return h_ctr;
    }

    oracle KEM_Get(h: Integer) -> Shk {
        assert not (Valid[h] == None);
        return Unwrap(Key[h]);
    }
}
