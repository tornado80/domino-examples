package KEMReductionLazy {
    /*
     * Reduction to KeyLazy. Runs the KEM locally. The shared key of an
     * encapsulation to an honest public key lives in KeyLazy, and
     * decapsulation of that ciphertext aliases its handle.
     * Not an assumption: the equivalences around it are proved.
     */

    types {
        Pk,
        Sk,
        Ctxt,
        Shk,
        KgenRand,
        EncRand,
    }

    params {
        kem_kgen:   fn KgenRand -> (Pk, Sk),
        kem_encaps: fn EncRand, Pk -> (Ctxt, Shk),
        kem_decaps: fn Sk, Ctxt -> Shk,
    }

    state {
        hk_ctr: Integer,
        h_ctr:  Integer,
        PK:     Table(Integer, Pk),
        SK:     Table(Integer, Sk),
        Hon:    Table(Pk, ()),
        Seen:   Table(Pk, ()),
        HC:     Table((Pk, Ctxt), Integer),
        Key:    Table(Integer, Shk),
        Alias:  Table(Integer, Integer),
        Valid:  Table(Integer, ()),
    }

    import oracles {
        Lazy_Init(h: Integer),
        Lazy_Get(h: Integer) -> Shk,
    }

    oracle KEM_Gen() -> (Pk, Integer) {
        r <-$ KgenRand sample-name kem_kgen;
        (pk, sk) <- parse kem_kgen(r);
        assert (Hon[pk] == None);
        assert (Seen[pk] == None);
        hk_ctr <- (hk_ctr + 1);
        PK[hk_ctr] <- Some(pk);
        SK[hk_ctr] <- Some(sk);
        Hon[pk] <- Some(());
        return (pk, hk_ctr);
    }

    oracle KEM_Encaps(pk: Pk) -> (Ctxt, Integer) {
        r <-$ EncRand sample-name kem_encaps;
        (c, shk) <- parse kem_encaps(r, pk);
        h_ctr <- (h_ctr + 1);
        Valid[h_ctr] <- Some(());
        if not (Hon[pk] == None) {
            assert (HC[(pk, c)] == None);
            HC[(pk, c)] <- Some(h_ctr);
            invoke Lazy_Init(h_ctr);
        } else {
            Key[h_ctr] <- Some(shk);
        }
        Seen[pk] <- Some(());
        return (c, h_ctr);
    }

    oracle KEM_Decaps(hk: Integer, c: Ctxt) -> Integer {
        pk <- Unwrap(PK[hk]);
        sk <- Unwrap(SK[hk]);
        h_ctr <- (h_ctr + 1);
        Valid[h_ctr] <- Some(());
        e <- HC[(pk, c)];
        if not (e == None) {
            Alias[h_ctr] <- e;
        } else {
            Key[h_ctr] <- Some(kem_decaps(sk, c));
        }
        return h_ctr;
    }

    oracle KEM_Get(h: Integer) -> Shk {
        assert not (Valid[h] == None);
        r <- h;
        if not (Alias[h] == None) {
            r <- Unwrap(Alias[h]);
        }
        if not (Key[r] == None) {
            return Unwrap(Key[r]);
        }
        shk <- invoke Lazy_Get(r);
        return shk;
    }
}
