package KEMReductionPrf {
    /*
     * Reduction to KEMPrf. The collision aborts established by KEMCollisions
     * stay here. Not an assumption: the equivalences around it are proved.
     */

    types {
        Pk,
        Ctxt,
    }

    state {
        Hon: Table(Pk, ()),
        HC:  Table((Pk, Ctxt), ()),
    }

    import oracles {
        KP_Gen() -> Pk,
        KP_Encaps(pk: Pk) -> Ctxt,
    }

    oracle KEM_Gen() -> Pk {
        pk <- invoke KP_Gen();
        assert (Hon[pk] == None);
        Hon[pk] <- Some(());
        return pk;
    }

    oracle KEM_Encaps(pk: Pk) -> Ctxt {
        c <- invoke KP_Encaps(pk);
        assert (HC[(pk, c)] == None);
        HC[(pk, c)] <- Some(());
        return c;
    }
}
