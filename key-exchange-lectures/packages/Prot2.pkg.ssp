package Prot2 {
    /*
     * Key exchange protocol II (10-lecture.tex, Fig. protocolII):
     * one-sided authentication with forward secrecy.
     *
     *   Initiator (pk)                               Responder (pk, sk)
     *   (pk_fs, sk_fs) <-$ kgen
     *   (c_R, shk_R) <-$ encaps(pk) --- pk_fs,c_R -> shk_R <- decaps(sk, c_R)
     *                                                (c_fs, shk_fs) <-$ encaps(pk_fs)
     *   verify(shk_R, (pk_fs,c_R,c_fs), t_R)  <- c_fs,t_R -- t_R <- mac(shk_R, (pk_fs,c_R,c_fs))
     *   shk_fs <- decaps(sk_fs, c_fs)
     *   k <- shk_fs; delete sk_fs                    k <- shk_fs
     *
     * MAC verification is canonical: verify(k, m, t) is mac(k, m) == t.
     *
     * Session state (see Model2.pkg.ssp), with Msg1 = (Pk, Ctxt),
     * Msg2 = (Ctxt, Tag), Key = Shk and Other = (Maybe(Sk), Shk):
     *   (role, pk, sk, msg1, msg2, k, other, accepted)
     *
     * other holds the initiator's (sk_fs, shk_R). sk_fs is set to None when
     * the session finishes, modelling the deletion of the ephemeral key.
     */

    types {
        Pk,
        Sk,
        Ctxt,
        Shk,
        Tag,
    }

    params {
        mac: fn Shk, (Pk, Ctxt, Ctxt) -> Tag,
    }

    import oracles {
        KEM_Gen() -> (Pk, Sk),
        KEM_Encaps(pk: Pk) -> (Ctxt, Shk),
        KEM_Decaps(sk: Sk, c: Ctxt) -> Shk,
    }

    /* Long-term key generation, part of the protocol syntax. */
    oracle Kgen() -> (Pk, Sk) {
        (pk, sk) <- parse invoke KEM_Gen();
        return (pk, sk);
    }

    /* Initiator: ephemeral key pair and encapsulation to the responder. */
    oracle Run1(st: (Bool, Pk, Maybe(Sk), Maybe((Pk, Ctxt)), Maybe((Ctxt, Tag)), Maybe(Shk), Maybe((Maybe(Sk), Shk)), Maybe(Bool)))
        -> ((Pk, Ctxt), (Bool, Pk, Maybe(Sk), Maybe((Pk, Ctxt)), Maybe((Ctxt, Tag)), Maybe(Shk), Maybe((Maybe(Sk), Shk)), Maybe(Bool)))
    {
        (role, pk, sk, msg1, msg2, k, other, accepted) <- parse st;
        assert (role == false);
        assert (accepted == None);
        assert (msg1 == None);

        (pk_fs, sk_fs) <- parse invoke KEM_Gen();
        (c_R, shk_R) <- parse invoke KEM_Encaps(pk);
        m1 <- (pk_fs, c_R);

        return (m1, (role, pk, sk, Some(m1), msg2, k, Some((Some(sk_fs), shk_R)), accepted));
    }

    /* Responder: decapsulate, encapsulate to pk_fs, authenticate and accept. */
    oracle Run2(st: (Bool, Pk, Maybe(Sk), Maybe((Pk, Ctxt)), Maybe((Ctxt, Tag)), Maybe(Shk), Maybe((Maybe(Sk), Shk)), Maybe(Bool)), m1: (Pk, Ctxt))
        -> ((Ctxt, Tag), (Bool, Pk, Maybe(Sk), Maybe((Pk, Ctxt)), Maybe((Ctxt, Tag)), Maybe(Shk), Maybe((Maybe(Sk), Shk)), Maybe(Bool)))
    {
        (role, pk, sk, msg1, msg2, k, other, accepted) <- parse st;
        assert (role == true);
        assert (accepted == None);
        assert (msg1 == None);

        (pk_fs, c_R) <- parse m1;
        shk_R <- invoke KEM_Decaps(Unwrap(sk), c_R);
        (c_fs, shk_fs) <- parse invoke KEM_Encaps(pk_fs);
        t_R <- mac(shk_R, (pk_fs, c_R, c_fs));
        m2 <- (c_fs, t_R);

        return (m2, (role, pk, sk, Some(m1), Some(m2), Some(shk_fs), other, Some(true)));
    }

    /* Initiator: verify the tag, decapsulate, delete sk_fs and accept. */
    oracle Run3(st: (Bool, Pk, Maybe(Sk), Maybe((Pk, Ctxt)), Maybe((Ctxt, Tag)), Maybe(Shk), Maybe((Maybe(Sk), Shk)), Maybe(Bool)), m2: (Ctxt, Tag))
        -> (Bool, Pk, Maybe(Sk), Maybe((Pk, Ctxt)), Maybe((Ctxt, Tag)), Maybe(Shk), Maybe((Maybe(Sk), Shk)), Maybe(Bool))
    {
        (role, pk, sk, msg1, msg2, k, other, accepted) <- parse st;
        assert (role == false);
        assert (accepted == None);
        assert not (msg1 == None);
        assert (msg2 == None);

        (pk_fs, c_R) <- parse Unwrap(msg1);
        (sk_fs, shk_R) <- parse Unwrap(other);
        (c_fs, t_R) <- parse m2;

        if (mac(shk_R, (pk_fs, c_R, c_fs)) == t_R) {
            shk_fs <- invoke KEM_Decaps(Unwrap(sk_fs), c_fs);
            return (role, pk, sk, msg1, Some(m2), Some(shk_fs), Some((None as Sk, shk_R)), Some(true));
        }

        return (role, pk, sk, msg1, Some(m2), k, Some((None as Sk, shk_R)), Some(false));
    }
}
