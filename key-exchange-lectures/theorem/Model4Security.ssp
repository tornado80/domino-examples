theorem Model4Security {
    /*
     * Key indistinguishability of Protocol IV in model KX_IV (forward secrecy, two-sided pre-shared-key authentication).
     *
     * Packages and games are generic in all types. The theorem instantiates
     * them with bitstrings, because abstract theorem-level types are not in
     * scope for the theorem's const declarations on this Domino branch.
     */

    const lpsk:  Integer;
    const lpk:   Integer;
    const lsk:   Integer;
    const lct:   Integer;
    const lshk:  Integer;
    const ltag:  Integer;
    const lkgr:  Integer;
    const lencr: Integer;

    const mac:        fn Bits(lpsk), (Bits(lpk), Bits(lct), Maybe(Bits(ltag))) -> Bits(ltag);
    const kem_kgen:   fn Bits(lkgr) -> (Bits(lpk), Bits(lsk));
    const kem_encaps: fn Bits(lencr), Bits(lpk) -> (Bits(lct), Bits(lshk));
    const kem_decaps: fn Bits(lsk), Bits(lct) -> Bits(lshk);

    instance KX4_0 = KX4 {
        types {
            Psk:      Bits(lpsk),
            Pk:       Bits(lpk),
            Sk:       Bits(lsk),
            Ctxt:     Bits(lct),
            Shk:      Bits(lshk),
            Tag:      Bits(ltag),
            KgenRand: Bits(lkgr),
            EncRand:  Bits(lencr),
        }
        params {
            b:          false,
            mac:        mac,
            kem_kgen:   kem_kgen,
            kem_encaps: kem_encaps,
            kem_decaps: kem_decaps,
        }
    }

    instance KX4_1 = KX4 {
        types {
            Psk:      Bits(lpsk),
            Pk:       Bits(lpk),
            Sk:       Bits(lsk),
            Ctxt:     Bits(lct),
            Shk:      Bits(lshk),
            Tag:      Bits(ltag),
            KgenRand: Bits(lkgr),
            EncRand:  Bits(lencr),
        }
        params {
            b:          true,
            mac:        mac,
            kem_kgen:   kem_kgen,
            kem_encaps: kem_encaps,
            kem_decaps: kem_decaps,
        }
    }

    gamehops {
        conjecture KX4_0 KX4_1
    }

    propositions {
        KX4Secure: KX4_0 ~ KX4_1
    }
}
