theorem Model4Security {
    /*
     * Key indistinguishability of Protocol IV in model KX_IV (forward secrecy,
     * two-sided pre-shared-key authentication).
     *
     * Packages and games are generic in all types. The theorem instantiates
     * them with bitstrings, because abstract theorem-level types are not in
     * scope for the theorem's const declarations on this Domino branch.
     *
     * Hops 0 to 6 are proved for the symbolic Test bit b. The last hop
     * switches b in the fully idealised game.
     *
     * Each assumption has its own small package and game. The reduction
     * packages KEMReductionCollisions, KEMReductionIndCca and KEMReductionLazy
     * are not assumptions: the equivalences around them are proved.
     *
     * No correctness assumption is needed: in the lecture's IND-CCA game, the
     * ideal decapsulation returns T[c] for honest ciphertexts.
     *
     * Assumptions:
     *
     *   KEMCollisions  Statistical, from the min-entropy of public keys and
     *                  ciphertexts. Returning sk changes nothing, because the
     *                  samples are independent.
     *   MAC            Multi-key EUF-CMA with adaptive corruption, in
     *                  real/ideal form. Before corruption, the two games differ
     *                  only on a forgery for that key. Proved from the
     *                  single-key game in theorem MACMultiKeySecurity.
     *   KEMIndCca      The lecture's Gpind-cca with one extra key index.
     *                  Implied by the single-key game, with a loss of a factor
     *                  of the number of keys.
     *   KEMLazy        Perfect: sampling a key at registration or at first use
     *                  is the same distribution. Domino cannot prove this
     *                  itself, because the sample moves across oracles.
     */

    const b:     Bool;
    const lpsk:  Integer;
    const lpk:   Integer;
    const lsk:   Integer;
    const lct:   Integer;
    const lshk:  Integer;
    const ltag:  Integer;
    const lkgr:  Integer;
    const lencr: Integer;

    const mac:        fn Bits(lpsk), (Bits(lpk), Bits(lct), Maybe(Bits(ltag))) -> Bits(ltag);
    const kem_kgen:   fn Bits(lkgr) -> (Bits(lpk), Bits(lsk));
    const kem_encaps: fn Bits(lencr), Bits(lpk) -> (Bits(lct), Bits(lshk));
    const kem_decaps: fn Bits(lsk), Bits(lct) -> Bits(lshk);

    instance KX4_0 = KX4 {
        types {
            Psk:      Bits(lpsk),
            Pk:       Bits(lpk),
            Sk:       Bits(lsk),
            Ctxt:     Bits(lct),
            Shk:      Bits(lshk),
            Tag:      Bits(ltag),
            KgenRand: Bits(lkgr),
            EncRand:  Bits(lencr),
        }
        params {
            b: false,
            mac:        mac,
            kem_kgen:   kem_kgen,
            kem_encaps: kem_encaps,
            kem_decaps: kem_decaps,
        }
    }

    instance KX4_1 = KX4 {
        types {
            Psk:      Bits(lpsk),
            Pk:       Bits(lpk),
            Sk:       Bits(lsk),
            Ctxt:     Bits(lct),
            Shk:      Bits(lshk),
            Tag:      Bits(ltag),
            KgenRand: Bits(lkgr),
            EncRand:  Bits(lencr),
        }
        params {
            b: true,
            mac:        mac,
            kem_kgen:   kem_kgen,
            kem_encaps: kem_encaps,
            kem_decaps: kem_decaps,
        }
    }

    instance KX4_b = KX4 {
        types {
            Psk:      Bits(lpsk),
            Pk:       Bits(lpk),
            Sk:       Bits(lsk),
            Ctxt:     Bits(lct),
            Shk:      Bits(lshk),
            Tag:      Bits(ltag),
            KgenRand: Bits(lkgr),
            EncRand:  Bits(lencr),
        }
        params {
            b: b,
            mac:        mac,
            kem_kgen:   kem_kgen,
            kem_encaps: kem_encaps,
            kem_decaps: kem_decaps,
        }
    }

    instance Model4Security_Hybrid0_b_0 = Model4Security_Hybrid0 {
        types {
            Psk:      Bits(lpsk),
            Pk:       Bits(lpk),
            Sk:       Bits(lsk),
            Ctxt:     Bits(lct),
            Shk:      Bits(lshk),
            Tag:      Bits(ltag),
            KgenRand: Bits(lkgr),
            EncRand:  Bits(lencr),
        }
        params {
            b: b,
            b_coll: false,
            mac:        mac,
            kem_kgen:   kem_kgen,
            kem_encaps: kem_encaps,
            kem_decaps: kem_decaps,
        }
    }

    instance Model4Security_Hybrid0_b_1 = Model4Security_Hybrid0 {
        types {
            Psk:      Bits(lpsk),
            Pk:       Bits(lpk),
            Sk:       Bits(lsk),
            Ctxt:     Bits(lct),
            Shk:      Bits(lshk),
            Tag:      Bits(ltag),
            KgenRand: Bits(lkgr),
            EncRand:  Bits(lencr),
        }
        params {
            b: b,
            b_coll: true,
            mac:        mac,
            kem_kgen:   kem_kgen,
            kem_encaps: kem_encaps,
            kem_decaps: kem_decaps,
        }
    }

    instance Model4Security_Hybrid1_b_0_0 = Model4Security_Hybrid1 {
        types {
            Psk:      Bits(lpsk),
            Pk:       Bits(lpk),
            Sk:       Bits(lsk),
            Ctxt:     Bits(lct),
            Shk:      Bits(lshk),
            Tag:      Bits(ltag),
            KgenRand: Bits(lkgr),
            EncRand:  Bits(lencr),
        }
        params {
            b: b,
            b_mac: false,
            b_ind: false,
            mac:        mac,
            kem_kgen:   kem_kgen,
            kem_encaps: kem_encaps,
            kem_decaps: kem_decaps,
        }
    }

    instance Model4Security_Hybrid1_b_1_0 = Model4Security_Hybrid1 {
        types {
            Psk:      Bits(lpsk),
            Pk:       Bits(lpk),
            Sk:       Bits(lsk),
            Ctxt:     Bits(lct),
            Shk:      Bits(lshk),
            Tag:      Bits(ltag),
            KgenRand: Bits(lkgr),
            EncRand:  Bits(lencr),
        }
        params {
            b: b,
            b_mac: true,
            b_ind: false,
            mac:        mac,
            kem_kgen:   kem_kgen,
            kem_encaps: kem_encaps,
            kem_decaps: kem_decaps,
        }
    }

    instance Model4Security_Hybrid1_b_1_1 = Model4Security_Hybrid1 {
        types {
            Psk:      Bits(lpsk),
            Pk:       Bits(lpk),
            Sk:       Bits(lsk),
            Ctxt:     Bits(lct),
            Shk:      Bits(lshk),
            Tag:      Bits(ltag),
            KgenRand: Bits(lkgr),
            EncRand:  Bits(lencr),
        }
        params {
            b: b,
            b_mac: true,
            b_ind: true,
            mac:        mac,
            kem_kgen:   kem_kgen,
            kem_encaps: kem_encaps,
            kem_decaps: kem_decaps,
        }
    }

    instance Model4Security_Hybrid2_b_0 = Model4Security_Hybrid2 {
        types {
            Psk:      Bits(lpsk),
            Pk:       Bits(lpk),
            Sk:       Bits(lsk),
            Ctxt:     Bits(lct),
            Shk:      Bits(lshk),
            Tag:      Bits(ltag),
            KgenRand: Bits(lkgr),
            EncRand:  Bits(lencr),
        }
        params {
            b: b,
            b_lazy: false,
            mac:        mac,
            kem_kgen:   kem_kgen,
            kem_encaps: kem_encaps,
            kem_decaps: kem_decaps,
        }
    }

    instance Model4Security_Hybrid2_b_1 = Model4Security_Hybrid2 {
        types {
            Psk:      Bits(lpsk),
            Pk:       Bits(lpk),
            Sk:       Bits(lsk),
            Ctxt:     Bits(lct),
            Shk:      Bits(lshk),
            Tag:      Bits(ltag),
            KgenRand: Bits(lkgr),
            EncRand:  Bits(lencr),
        }
        params {
            b: b,
            b_lazy: true,
            mac:        mac,
            kem_kgen:   kem_kgen,
            kem_encaps: kem_encaps,
            kem_decaps: kem_decaps,
        }
    }

    instance Model4Security_Hybrid2_0_1 = Model4Security_Hybrid2 {
        types {
            Psk:      Bits(lpsk),
            Pk:       Bits(lpk),
            Sk:       Bits(lsk),
            Ctxt:     Bits(lct),
            Shk:      Bits(lshk),
            Tag:      Bits(ltag),
            KgenRand: Bits(lkgr),
            EncRand:  Bits(lencr),
        }
        params {
            b: false,
            b_lazy: true,
            mac:        mac,
            kem_kgen:   kem_kgen,
            kem_encaps: kem_encaps,
            kem_decaps: kem_decaps,
        }
    }

    instance Model4Security_Hybrid2_1_1 = Model4Security_Hybrid2 {
        types {
            Psk:      Bits(lpsk),
            Pk:       Bits(lpk),
            Sk:       Bits(lsk),
            Ctxt:     Bits(lct),
            Shk:      Bits(lshk),
            Tag:      Bits(ltag),
            KgenRand: Bits(lkgr),
            EncRand:  Bits(lencr),
        }
        params {
            b: true,
            b_lazy: true,
            mac:        mac,
            kem_kgen:   kem_kgen,
            kem_encaps: kem_encaps,
            kem_decaps: kem_decaps,
        }
    }

    instance KEMCollisionsGame_0 = KEMCollisionsGame {
        types {
            Pk:       Bits(lpk),
            Sk:       Bits(lsk),
            Ctxt:     Bits(lct),
            Shk:      Bits(lshk),
            KgenRand: Bits(lkgr),
            EncRand:  Bits(lencr),
        }
        params {
            b_coll: false,
            kem_kgen:   kem_kgen,
            kem_encaps: kem_encaps,
        }
    }

    instance KEMCollisionsGame_1 = KEMCollisionsGame {
        types {
            Pk:       Bits(lpk),
            Sk:       Bits(lsk),
            Ctxt:     Bits(lct),
            Shk:      Bits(lshk),
            KgenRand: Bits(lkgr),
            EncRand:  Bits(lencr),
        }
        params {
            b_coll: true,
            kem_kgen:   kem_kgen,
            kem_encaps: kem_encaps,
        }
    }

    instance KEMIndCcaGame_0 = KEMIndCcaGame {
        types {
            Pk:       Bits(lpk),
            Sk:       Bits(lsk),
            Ctxt:     Bits(lct),
            Shk:      Bits(lshk),
            KgenRand: Bits(lkgr),
            EncRand:  Bits(lencr),
        }
        params {
            b_ind: false,
            kem_kgen:   kem_kgen,
            kem_encaps: kem_encaps,
            kem_decaps: kem_decaps,
        }
    }

    instance KEMIndCcaGame_1 = KEMIndCcaGame {
        types {
            Pk:       Bits(lpk),
            Sk:       Bits(lsk),
            Ctxt:     Bits(lct),
            Shk:      Bits(lshk),
            KgenRand: Bits(lkgr),
            EncRand:  Bits(lencr),
        }
        params {
            b_ind: true,
            kem_kgen:   kem_kgen,
            kem_encaps: kem_encaps,
            kem_decaps: kem_decaps,
        }
    }

    instance KeyLazyGame_0 = KeyLazyGame {
        types {
            Shk: Bits(lshk),
        }
        params {
            b_lazy: false,
        }
    }

    instance KeyLazyGame_1 = KeyLazyGame {
        types {
            Shk: Bits(lshk),
        }
        params {
            b_lazy: true,
        }
    }

    instance MACMultiKeyGame_0 = MACMultiKeyGame {
        types {
            Psk: Bits(lpsk),
            Msg: (Bits(lpk), Bits(lct), Maybe(Bits(ltag))),
            Tag: Bits(ltag),
        }
        params {
            b_mac: false,
            mac:   mac,
        }
    }

    instance MACMultiKeyGame_1 = MACMultiKeyGame {
        types {
            Psk: Bits(lpsk),
            Msg: (Bits(lpk), Bits(lct), Maybe(Bits(ltag))),
            Tag: Bits(ltag),
        }
        params {
            b_mac: true,
            mac:   mac,
        }
    }

    assumptions {
        KEMCollisions: KEMCollisionsGame_0 ~ KEMCollisionsGame_1
        MAC:           MACMultiKeyGame_0   ~ MACMultiKeyGame_1
        KEMIndCca:     KEMIndCcaGame_0     ~ KEMIndCcaGame_1
        KEMLazy:       KeyLazyGame_0       ~ KeyLazyGame_1
    }

    gamehops {
        equivalence KX4_b Model4Security_Hybrid0_b_0 {
            invariant: [
                ./theorem/invariant-KX4_b-Model4Security_Hybrid0_b_0.smt2
            ]
            NewKey: {
                randomness: custom
            }
            Corrupt: {
                randomness: custom
            }
            NewSession: {
                randomness: custom
            }
            Send1: {
                randomness: custom
            }
            Send2: {
                randomness: custom
            }
            Send3: {
                randomness: custom
            }
            Send4: {
                randomness: custom
            }
            Reveal: {
                randomness: custom
            }
            Test: {
                randomness: custom
            }
        }

        reduction Model4Security_Hybrid0_b_0 Model4Security_Hybrid0_b_1 {
            assumption KEMCollisions
            map KEMCollisionsGame_0 Model4Security_Hybrid0_b_0 {
                KEMCollisions: KEMCollisions
            }
            map KEMCollisionsGame_1 Model4Security_Hybrid0_b_1 {
                KEMCollisions: KEMCollisions
            }
        }

        equivalence Model4Security_Hybrid0_b_1 Model4Security_Hybrid1_b_0_0 {
            invariant: [
                ./theorem/invariant-Model4Security_Hybrid0_b_1-Model4Security_Hybrid1_b_0_0.smt2
            ]
            NewKey: {
                randomness: custom
            }
            Corrupt: {
                randomness: custom
            }
            NewSession: {
                randomness: custom
            }
            Send1: {
                randomness: custom
            }
            Send2: {
                randomness: custom
            }
            Send3: {
                randomness: custom
            }
            Send4: {
                randomness: custom
            }
            Reveal: {
                randomness: custom
            }
            Test: {
                randomness: custom
            }
        }

        reduction Model4Security_Hybrid1_b_0_0 Model4Security_Hybrid1_b_1_0 {
            assumption MAC
            map MACMultiKeyGame_0 Model4Security_Hybrid1_b_0_0 {
                MACMultiKey: MACMultiKey
            }
            map MACMultiKeyGame_1 Model4Security_Hybrid1_b_1_0 {
                MACMultiKey: MACMultiKey
            }
        }

        reduction Model4Security_Hybrid1_b_1_0 Model4Security_Hybrid1_b_1_1 {
            assumption KEMIndCca
            map KEMIndCcaGame_0 Model4Security_Hybrid1_b_1_0 {
                KEMIndCca: KEMIndCca
            }
            map KEMIndCcaGame_1 Model4Security_Hybrid1_b_1_1 {
                KEMIndCca: KEMIndCca
            }
        }

        equivalence Model4Security_Hybrid1_b_1_1 Model4Security_Hybrid2_b_0 {
            invariant: [
                ./theorem/invariant-Model4Security_Hybrid1_b_1_1-Model4Security_Hybrid2_b_0.smt2
            ]
            NewKey: {
                randomness: custom
            }
            Corrupt: {
                randomness: custom
            }
            NewSession: {
                randomness: custom
            }
            Send1: {
                randomness: custom
            }
            Send2: {
                randomness: custom
            }
            Send3: {
                randomness: custom
            }
            Send4: {
                randomness: custom
            }
            Reveal: {
                randomness: custom
            }
            Test: {
                randomness: custom
            }
        }

        reduction Model4Security_Hybrid2_b_0 Model4Security_Hybrid2_b_1 {
            assumption KEMLazy
            map KeyLazyGame_0 Model4Security_Hybrid2_b_0 {
                KeyLazy: KeyLazy
            }
            map KeyLazyGame_1 Model4Security_Hybrid2_b_1 {
                KeyLazy: KeyLazy
            }
        }

        equivalence Model4Security_Hybrid2_0_1 Model4Security_Hybrid2_1_1 {
            invariant: [
                ./theorem/invariant-Model4Security_Hybrid2_0_1-Model4Security_Hybrid2_1_1.smt2
            ]
            NewKey: {
                randomness: custom
                lemmas {
                    eq-model: [no-abort]
                    eq-mac: [no-abort]
                    eq-kem: [no-abort]
                    corr-eq: [no-abort]
                    bound-kem: [no-abort]
                    bound-alias: [no-abort]
                    bound-hc: [no-abort]
                    hc-reg: [no-abort]
                    bound-pk: [no-abort]
                    bound-sess: [no-abort]
                    psk-self: [no-abort]
                    sess-kid: [no-abort]
                    fresh-accepted: [no-abort]
                    resp-shape: [no-abort]
                    resp-k: [no-abort]
                    init-shape: [no-abort]
                    init-m2-m1: [no-abort]
                    init-accepted: [no-abort]
                    hc-prov: [no-abort]
                    resp-unique: [no-abort]
                    t-none-seen: [no-abort]
                    t-none-prov: [no-abort]
                    t-none-hc: [no-abort]
                    t-some-prov: [no-abort]
                    fresh-init-t: [no-abort]
                    fresh-init-alias: [no-abort, fresh-init-t]
                    fresh-resp-t: [no-abort]
                    key-rel: [no-abort]
                    key-unset: [no-abort]
                    equal-aborts: []
                    same-output: [no-abort]
                    invariant: [no-abort, eq-model, eq-mac, eq-kem, corr-eq, bound-kem, bound-alias, bound-hc, hc-reg, bound-pk, bound-sess, psk-self, sess-kid, fresh-accepted, resp-shape, resp-k, init-shape, init-m2-m1, init-accepted, hc-prov, resp-unique, t-none-seen, t-none-prov, t-none-hc, t-some-prov, fresh-init-t, fresh-init-alias, fresh-resp-t, key-rel, key-unset]
                }
            }
            Corrupt: {
                randomness: custom
                lemmas {
                    eq-model: [no-abort]
                    eq-mac: [no-abort]
                    eq-kem: [no-abort]
                    corr-eq: [no-abort]
                    bound-kem: [no-abort]
                    bound-alias: [no-abort]
