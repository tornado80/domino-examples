                    fresh-resp-t: [no-abort]
                    key-rel: [no-abort]
                    key-unset: [no-abort]
                    equal-aborts: []
                    same-output: [no-abort]
                    invariant: [no-abort, eq-model, eq-mac, eq-kem, corr-eq, bound-kem, bound-alias, bound-hc, bound-pk, bound-sess, psk-self, sess-kid, fresh-accepted, resp-shape, resp-k, init-shape, init-m2-m1, init-accepted, hc-prov, resp-unique, t-none-seen, t-none-prov, t-none-hc, t-some-prov, fresh-init-t, fresh-init-alias, fresh-resp-t, key-rel, key-unset]
