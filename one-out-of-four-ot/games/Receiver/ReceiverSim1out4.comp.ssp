composition ReceiverSim1out4 {
    types {
        Msg,
        Key,
        EncRnd,
        Ctxt,
        SimRnds,
        RecvIncMsg1out2,
        RecvRnd1out2
    }

    const enc_inner: fn Key, Msg, EncRnd -> Ctxt;
    const enc_outer: fn Key, Ctxt, EncRnd -> Ctxt;
    const zeros_msg: Msg;
    const zeros_ctxt: Ctxt;
    const sim1out2: fn Bool, Key, SimRnds -> (RecvRnd1out2, RecvIncMsg1out2);

    instance ReceiverFunc1out4 = ReceiverFunc1out4 {
        types {
            Msg: Msg,
            RecvRnd1out4: (RecvRnd1out2, RecvRnd1out2),
            RecvIncMsg1out4: (Table((Bool, Bool), Ctxt), RecvIncMsg1out2, RecvIncMsg1out2),
        }
    }

    instance ReceiverSim1out4 = ReceiverSim1out4 {
        types {
            Msg: Msg,
            Key: Key,
            EncRnd: EncRnd,
            Ctxt: Ctxt,
            RecvIncMsg1out2: RecvIncMsg1out2,
            RecvRnd1out2: RecvRnd1out2,
        }
        params {
            enc_inner: enc_inner,
            enc_outer: enc_outer,
            zeros_msg: zeros_msg,
            zeros_ctxt: zeros_ctxt,
        }
    }

    instance ReceiverSim1out2 = ReceiverSim1out2 {
        types {
            ReceiverInput1out2: Bool,
            Key: Key,
            SimRnds: SimRnds,
            RecvIncMsg1out2: RecvIncMsg1out2,
            RecvRnd1out2: RecvRnd1out2,
        }
        params {
            sim1out2: sim1out2,
        }
    }

    compose {
        adversary: {
            GetView: ReceiverFunc1out4,
        },
        ReceiverFunc1out4: {
            GetSimView: ReceiverSim1out4,
        },
        ReceiverSim1out4: {
            GetSimView: ReceiverSim1out2,
        },
    }
}
