composition SenderSim1out2 {
    types {
        Key,
        SimRnds,
        SendIncMsg1out2,
        SendRnd1out2
    }

    const sim1out2: fn (Key, Key), SimRnds -> (SendRnd1out2, SendIncMsg1out2);

    instance SenderFunc1out2 = SenderFunc1out2 {
        types {
            SenderInput1out2: (Key, Key),
            ReceiverInput1out2: Bool,
            SendIncMsg1out2: SendIncMsg1out2,
            SendRnd1out2: SendRnd1out2,
        }
    }

    instance SenderSim1out2 = SenderSim1out2 {
        types {
            SenderInput1out2: (Key, Key),
            SimRnds: SimRnds,
            SendIncMsg1out2: SendIncMsg1out2,
            SendRnd1out2: SendRnd1out2,
        }
        params {
            sim1out2: sim1out2,
        }
    }

    compose {
        adversary: {
            GetView: SenderFunc1out2,
        },
        SenderFunc1out2: {
            GetSimView: SenderSim1out2,
        },
    }
}
