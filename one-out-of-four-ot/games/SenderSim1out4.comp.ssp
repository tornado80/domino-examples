composition SenderSim1out4 {
    types {
        Msg,
        Key,
        EncRnds,
        SimRnds,
        SendIncMsg1out2,
        SendRnd1out2,
        RecvRnd1out2
    }

    const sim1out2: fn Key, Key, SimRnds -> (SendRnd1out2, SendIncMsg1out2);

    instance func4 = SenderFunc1out4 {
        types {
            Msg: Msg,
            Key: Key,
            EncRnds: EncRnds,
            SendIncMsg1out2: SendIncMsg1out2,
            SendRnd1out2: SendRnd1out2,
        }
    }

    instance sim4 = SenderSim1out4 {
        types {
            Msg: Msg,
            Key: Key,
            EncRnds: EncRnds,
            SendIncMsg1out2: SendIncMsg1out2,
            SendRnd1out2: SendRnd1out2,
            RecvRnd1out2: RecvRnd1out2,
        }
    }

    instance sim2 = SenderSim1out2 {
        types {
            Key: Key,
            SimRnds: SimRnds,
            SendIncMsg1out2: SendIncMsg1out2,
            SendRnd1out2: SendRnd1out2,
        }
        params {
            sim1out2: sim1out2,
        }
    }

    compose {
        adversary: {
            GetView: func4,
        },
        func4: {
            GetSimView: sim4,
        },
        sim4: {
            GetSimView: sim2,
        },
    }
}
