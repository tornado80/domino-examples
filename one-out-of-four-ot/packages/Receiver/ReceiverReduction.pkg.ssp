package ReceiverReduction {
    types {
        Msg,
        Key,
        EncRnd,
        Ctxt,
        RecvIncMsg1out2,
        RecvRnd1out2
    }

    import oracles {
        EncInner(m: (Msg, Msg)) -> (Ctxt, Ctxt),
        EncOuter(m: (Ctxt, Ctxt)) -> (Ctxt, Ctxt),
        GetSimView(b: Bool, output: Key) -> (RecvRnd1out2, RecvIncMsg1out2),
    }

    params {
        enc_inner: fn Key, Msg, EncRnd -> Ctxt,
        enc_outer: fn Key, Ctxt, EncRnd -> Ctxt
    }

    oracle GetView(inputs: ((Msg, Msg, Msg, Msg), (Bool, Bool)))
        -> ((RecvRnd1out2, RecvRnd1out2),
        (Table((Bool, Bool), Ctxt), RecvIncMsg1out2, RecvIncMsg1out2))
    {
        (s, b) <- inputs;
        (bi, bo) <- b; /* b_inner and b_outer */
        (s00, s01, s10, s11) <- s;

        /* row bi is encrypted under the active inner key,
        row not bi under the inactive inner key of the inner CPA game */
        ma0 <- s00;
        ma1 <- s01;
        mx0 <- s10;
        mx1 <- s11;
        if bi {
            ma0 <- s10;
            ma1 <- s11;
            mx0 <- s00;
            mx1 <- s01;
        }

        /* Encryption keys */
        kia <-$ Key sample-name kia; /* k_inner_b_active */
        koa <-$ Key sample-name koa; /* k_outer_b_active */

        /* Encryption randomness */
        ria0 <-$ EncRnd sample-name ria0;
        ria1 <-$ EncRnd sample-name ria1;
        ro1 <-$ EncRnd sample-name ro1;
        ro2 <-$ EncRnd sample-name ro2;

        /* Inner encryptions */
        (cx0, cx1) <- invoke EncInner((mx0, mx1));
        ca0 <- enc_inner(kia, ma0, ria0);
        ca1 <- enc_inner(kia, ma1, ria1);

        /* the inner ciphertexts of row bi and not bi, in column bo and not bo */
        caa <- ca0;
        cax <- ca1;
        cxa <- cx0;
        cxx <- cx1;
        if bo {
            caa <- ca1;
            cax <- ca0;
            cxa <- cx1;
            cxx <- cx0;
        }

        /* Outer encryptions: column not bo under the inactive outer key of the outer CPA game */
        (dax, dxx) <- invoke EncOuter((cax, cxx));

        C <- new Table((Bool, Bool), Ctxt);
        C[(bi, bo)] <- Some(enc_outer(koa, caa, ro1));
        C[(not bi, bo)] <- Some(enc_outer(koa, cxa, ro2));
        C[(bi, not bo)] <- Some(dax);
        C[(not bi, not bo)] <- Some(dxx);

        (rrecv0, msgs0) <- invoke GetSimView(bi, kia);
        (rrecv1, msgs1) <- invoke GetSimView(bo, koa);

        return ((rrecv0, rrecv1), (C, msgs0, msgs1));
    }
}
