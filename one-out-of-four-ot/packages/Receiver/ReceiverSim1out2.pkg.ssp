package ReceiverSim1out2 {
    types {
        ReceiverInput1out2,
        Key,
        SimRnds,
        RecvIncMsg1out2,
        RecvRnd1out2
    }

    params {
        sim1out2: fn ReceiverInput1out2, Key, SimRnds -> (RecvRnd1out2, RecvIncMsg1out2)
    }

    oracle GetSimView(b: ReceiverInput1out2, output: Key) -> (RecvRnd1out2, RecvIncMsg1out2)
    {
        rsim <-$ SimRnds sample-name rsim;
        return sim1out2(b, output, rsim);
    }
}
