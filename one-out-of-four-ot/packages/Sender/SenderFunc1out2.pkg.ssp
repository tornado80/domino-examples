package SenderFunc1out2 {
    types {
        SenderInput1out2,
        ReceiverInput1out2,
        SendIncMsg1out2,
        SendRnd1out2
    }

    import oracles {
        GetSimView(inputs: SenderInput1out2) -> (SendRnd1out2, SendIncMsg1out2),
    }

    oracle GetView(inputs: (SenderInput1out2, ReceiverInput1out2))
        -> (SendRnd1out2, SendIncMsg1out2)
    {
        (s, b) <- inputs;
        view <- invoke GetSimView(s);
        return view;
    }
}
