package SenderFunc1out4 {
    types {
        SenderInput1out4,
        ReceiverInput1out4,
        SendRnd1out4,
        SendIncMsg1out4
    }

    import oracles {
        GetSimView(inputs: SenderInput1out4) -> (SendRnd1out4, SendIncMsg1out4),
    }

    oracle GetView(inputs: (SenderInput1out4, ReceiverInput1out4))
        -> (SendRnd1out4, SendIncMsg1out4)
    {
        (s, b) <- inputs;
        view <- invoke GetSimView(s);
        return view;
    }
}
