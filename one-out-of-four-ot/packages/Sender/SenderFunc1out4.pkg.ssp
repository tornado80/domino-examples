package SenderFunc1out4 {
    types {
        Msg,
        Key,
        EncRnds,
        SendIncMsg1out2,
        SendRnd1out2
    }

    import oracles {
        GetSimView(inputs: (Msg, Msg, Msg, Msg)) -> 
        ((Key, Key, Key, Key, EncRnds, SendRnd1out2, SendRnd1out2), 
        (SendIncMsg1out2, SendIncMsg1out2)),
    }

    oracle GetView(inputs: ((Msg, Msg, Msg, Msg), (Bool, Bool))) 
        -> ((Key, Key, Key, Key, EncRnds, SendRnd1out2, SendRnd1out2), 
        (SendIncMsg1out2, SendIncMsg1out2))
    {
        (s, b) <- inputs;
        view <- invoke GetSimView(s);
        return view;
    }
}