package SenderSim1out2 {
    types {
        SenderInput1out2,
        SimRnds,
        SendIncMsg1out2,
        SendRnd1out2
    }

    params {
        sim1out2: fn SenderInput1out2, SimRnds -> (SendRnd1out2, SendIncMsg1out2)
    }

    oracle GetSimView(inputs: SenderInput1out2) -> (SendRnd1out2, SendIncMsg1out2)
    {
        rsim <-$ SimRnds sample-name rsim;
        return sim1out2(inputs, rsim);
    }
}
