package SenderSim1out4 {
    types {
        SenderInput1out4,
        Key,
        EncRnds,
        SendIncMsg1out2,
        SendRnd1out2
    }

    import oracles {
        GetSimView(inputs: (Key, Key)) -> (SendRnd1out2, SendIncMsg1out2),
    }

    oracle GetSimView(inputs: SenderInput1out4)
        -> ((Key, Key, Key, Key, EncRnds, SendRnd1out2, SendRnd1out2),
        (SendIncMsg1out2, SendIncMsg1out2))
    {
        k00 <-$ Key sample-name k00;
        k01 <-$ Key sample-name k01;
        k10 <-$ Key sample-name k10;
        k11 <-$ Key sample-name k11;
        renc <-$ EncRnds sample-name renc;
        (rsend0, msgs0) <- invoke GetSimView((k00, k01));
        (rsend1, msgs1) <- invoke GetSimView((k10, k11));
        return ((k00, k01, k10, k11, renc, rsend0, rsend1), (msgs0, msgs1));
    }
}
