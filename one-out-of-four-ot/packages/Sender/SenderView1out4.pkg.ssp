package SenderView1out4 {
    types {
        Msg,
        Key,
        EncRnds,
        SendIncMsg1out2,
        SendRnd1out2,
    }

    import oracles {
        GetView(inputs: (Key, Key, Bool)) -> (SendRnd1out2, SendIncMsg1out2),
    }

    oracle GetView(inputs: ((Msg, Msg, Msg, Msg), (Bool, Bool))) 
        -> ((Key, Key, Key, Key, EncRnds, SendRnd1out2, SendRnd1out2), 
        (SendIncMsg1out2, SendIncMsg1out2))
    {
        (s, b) <- inputs;
        (bl, br) <- b;
        k00 <-$ Key sample-name k00;
        k01 <-$ Key sample-name k01;
        k10 <-$ Key sample-name k10;
        k11 <-$ Key sample-name k11;
        renc <-$ EncRnds sample-name renc;
        view0 <- invoke GetView((k00, k01, bl));
        view1 <- invoke GetView((k10, k11, br));
        (rsend0, msgs0) <- view0;
        (rsend1, msgs1) <- view1;
        return ((k00, k01, k10, k11, renc, rsend0, rsend1), (msgs0, msgs1));
    }
}