theorem Sender1out4Security {
    /* Lengths of the (abstract) sets the protocol works over. */
    const n_msg: Integer;
    const n_key: Integer;
    const n_enc: Integer;
    const n_sim: Integer;
    const n_inc: Integer;
    const n_srnd: Integer;
    const n_rrnd: Integer;

    const view1out2: fn Bits(n_key), Bits(n_key), Bool, (Bits(n_srnd), Bits(n_rrnd))
                        -> Bits(n_inc);
    const sim1out2: fn Bits(n_key), Bits(n_key), Bits(n_sim)
                        -> (Bits(n_srnd), Bits(n_inc));

    /* 1-out-of-2 OT: real sender view and simulated sender view */
    instance SenderView1out2 = SenderView1out2 {
        types {
            Key: Bits(n_key),
            SendIncMsg1out2: Bits(n_inc),
            SendRnd1out2: Bits(n_srnd),
            RecvRnd1out2: Bits(n_rrnd),
        }
        params {
            view1out2: view1out2,
        }
    }

    instance SenderSim1out2 = SenderSim1out2 {
        types {
            Key: Bits(n_key),
            SimRnds: Bits(n_sim),
            SendIncMsg1out2: Bits(n_inc),
            SendRnd1out2: Bits(n_srnd),
        }
        params {
            sim1out2: sim1out2,
        }
    }

    /* 1-out-of-4 OT: real sender view, hybrid and simulated sender view */
    instance SenderView1out4 = SenderView1out4 {
        types {
            Msg: Bits(n_msg),
            Key: Bits(n_key),
            EncRnds: Bits(n_enc),
            SendIncMsg1out2: Bits(n_inc),
            SendRnd1out2: Bits(n_srnd),
            RecvRnd1out2: Bits(n_rrnd),
        }
        params {
            view1out2: view1out2,
        }
    }

    instance Sender1out4Security_Hybrid0 = Sender1out4Security_Hybrid0 {
        types {
            Msg: Bits(n_msg),
            Key: Bits(n_key),
            EncRnds: Bits(n_enc),
            SimRnds: Bits(n_sim),
            SendIncMsg1out2: Bits(n_inc),
            SendRnd1out2: Bits(n_srnd),
        }
        params {
            sim1out2: sim1out2,
        }
    }

    instance SenderSim1out4 = SenderSim1out4 {
        types {
            Msg: Bits(n_msg),
            Key: Bits(n_key),
            EncRnds: Bits(n_enc),
            SimRnds: Bits(n_sim),
            SendIncMsg1out2: Bits(n_inc),
            SendRnd1out2: Bits(n_srnd),
            RecvRnd1out2: Bits(n_rrnd),
        }
        params {
            sim1out2: sim1out2,
        }
    }

    assumptions {
        Sender1out2: SenderView1out2 ~ SenderSim1out2
    }

    gamehops {
        reduction SenderView1out4 Sender1out4Security_Hybrid0
        {
            assumption Sender1out2

            map SenderView1out2 SenderView1out4 {
                SenderView1out2: SenderView1out2
            }

            map SenderSim1out2 Sender1out4Security_Hybrid0 {
                SenderFunc1out2: SenderFunc1out2
                SenderSim1out2: SenderSim1out2
            }
        }

        equivalence Sender1out4Security_Hybrid0 SenderSim1out4 {
            invariant: [
                ./theorem/invariant-Sender1out4Security_Hybrid0-SenderSim1out4.smt2
            ]

            GetView: {
                lemmas {
                    equal-aborts: []
                    invariant: [no-abort]
                    same-output: [no-abort]
                }
            }
        }
    }

    propositions {
        SenderPrivacy: SenderView1out4 ~ SenderSim1out4
    }
}
