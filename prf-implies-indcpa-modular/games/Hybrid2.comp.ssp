composition Hybrid2 {
    const bmsg: Bool;
    const bxor: Bool;
    const bnonce: Bool;
    const prf: fn Bits(256), Bits(256) -> Bits(256);
    const xor: fn Bits(256), Bits(256) -> Bits(256);

    instance Xor = XOR {
        params {
            bxor: bxor,
            xor: xor
        }
    }

    instance Nonce = Nonce {
        params {
            bnonce: bnonce
        }
    }

    instance Message = Message {
        params {
            bmsg: bmsg,
        }
    }

    instance Reduction3 = Reduction3 {
    }

    compose {
        adversary: {
            Enc: Reduction3
        }
        Reduction3: {
            GetMessage: Message,
            Xor: Xor,
            Sample: Nonce
        }
    }
}