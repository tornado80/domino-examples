theorem PrfImpliesIndCpaModular {
    const b: Bool;
    const prf: fn Bits(256), Bits(256) -> Bits(256);
    const xor: fn Bits(256), Bits(256) -> Bits(256);
    
    instance Gnonce_0 = Gnonce {
        params {
            bnonce: false
        }
    }

    instance Gnonce_1 = Gnonce {
        params {
            bnonce: true
        }
    }

    instance Gprf_0 = Gprf {
        params {
            bprf: false,
            prf: prf
        }
    }

    instance Gprf_1 = Gprf {
        params {
            bprf: true,
            prf: prf
        }
    }

    instance Gxor_0 = Gxor {
        params {
            bxor: false,
            xor: xor
        }
    }

    instance Gxor_1 = Gxor {
        params {
            bxor: true,
            xor: xor
        }
    }

    instance Gcpa_b = Gcpa {
        params {
            bcpa: b,
            prf: prf,
            xor: xor
        }
    }

    instance Gcpa_0 = Gcpa {
        params {
            bcpa: false,
            prf: prf,
            xor: xor
        }
    }

    instance Gcpa_1 = Gcpa {
        params {
            bcpa: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid0_b_0 = Hybrid0 {
        params {
            bmsg: b,
            bprf: false,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid0_b_1 = Hybrid0 {
        params {
            bmsg: b,
            bprf: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid1_b_0 = Hybrid1 {
        params {
            bmsg: b,
            bnonce: false,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid1_b_1 = Hybrid1 {
        params {
            bmsg: b,
            bnonce: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid2_b_0 = Hybrid2 {
        params {
            bmsg: b,
            bxor: false,
            bnonce: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid2_b_1 = Hybrid2 {
        params {
            bmsg: b,
            bxor: true,
            bnonce: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid2_0_1 = Hybrid2 {
        params {
            bmsg: false,
            bxor: true,
            bnonce: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid2_1_1 = Hybrid2 {
        params {
            bmsg: true,
            bxor: true,
            bnonce: true,
            prf: prf,
            xor: xor
        }
    }

    assumptions {
        Nonces: Gnonce_0 ~ Gnonce_1
        PRF: Gprf_0 ~ Gprf_1 
        XOR: Gxor_0 ~ Gxor_1
    }

    gamehops {
        equivalence Gcpa_b Hybrid0_b_0 {
            invariant: [
                ./theorem/invariant-Gcpa_b-Hybrid0_b_0.smt2
            ]
            Enc: {
                randomness: custom
            }
        }
        reduction Hybrid0_b_0 Hybrid0_b_1 {
            assumption PRF
            map Gprf_0 Hybrid0_b_0 {
                PRF: PRF
            }
            map Gprf_1 Hybrid0_b_1 {
                PRF: PRF
            }
        }
        equivalence Hybrid0_b_1 Hybrid1_b_0 {
            invariant: [
                ./theorem/invariant-Hybrid0_b_1-Hybrid1_b_0.smt2
            ]
            Enc: {
                randomness: custom
            }
        }
        reduction Hybrid1_b_0 Hybrid1_b_1 {
            assumption Nonces
            map Gnonce_0 Hybrid1_b_0 {
                Nonce: Nonce
            }
            map Gnonce_1 Hybrid1_b_1 {
                Nonce: Nonce
            }
        }
        equivalence Hybrid1_b_1 Hybrid2_b_0 {
            invariant: [
                ./theorem/invariant-Hybrid1_b_1-Hybrid2_b_0.smt2
            ]
            Enc: {
                randomness: custom
            }
        }
        reduction Hybrid2_b_0 Hybrid2_b_1 {
            assumption XOR
            map Gxor_0 Hybrid2_b_0 {
                XOR: XOR
            }
            map Gxor_1 Hybrid2_b_1 {
                XOR: XOR
            }
        }
        equivalence Hybrid2_0_1 Hybrid2_1_1 {
            invariant: [
                ./theorem/invariant-Hybrid2_0_1-Hybrid2_1_1.smt2
            ]
            Enc: {
                randomness: simple
            }
        }
    }
    propositions {
        Main: Gcpa_0 ~ Gcpa_1
    }
}