theorem PrfImpliesIndCpa {
    const b: Bool;
    const prf: fn Bits(256), Bits(256) -> Bits(256);
    const xor: fn Bits(256), Bits(256) -> Bits(256);
    
    instance Gnonce0 = Gnonce {
        params {
            bnonce: false
        }
    }

    instance Gnonce1 = Gnonce {
        params {
            bnonce: true
        }
    }

    instance Gprf0 = Gprf {
        params {
            bprf: false,
            prf: prf
        }
    }

    instance Gprf1 = Gprf {
        params {
            bprf: true,
            prf: prf
        }
    }

    instance Gxor0 = Gxor {
        params {
            bxor: false,
            xor: xor
        }
    }

    instance Gxor1 = Gxor {
        params {
            bxor: true,
            xor: xor
        }
    }

    instance Gcpa = Gcpa {
        params {
            bcpa: b,
            prf: prf,
            xor: xor
        }
    }

    instance Gcpa0 = Gcpa {
        params {
            bcpa: false,
            prf: prf,
            xor: xor
        }
    }

    instance Gcpa1 = Gcpa {
        params {
            bcpa: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid0_b_0 = Hybrid0 {
        params {
            bmsg: b,
            bprf: false,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid0_b_1 = Hybrid0 {
        params {
            bmsg: b,
            bprf: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid1_b_0 = Hybrid1 {
        params {
            bmsg: b,
            bnonce: false,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid1_b_1 = Hybrid1 {
        params {
            bmsg: b,
            bnonce: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid2_b_0 = Hybrid2 {
        params {
            bmsg: b,
            bxor: false,
            bnonce: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid2_b_1 = Hybrid2 {
        params {
            bmsg: b,
            bxor: true,
            bnonce: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid2_0_1 = Hybrid2 {
        params {
            bmsg: false,
            bxor: true,
            bnonce: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid2_1_1 = Hybrid2 {
        params {
            bmsg: true,
            bxor: true,
            bnonce: true,
            prf: prf,
            xor: xor
        }
    }

    assumptions {
        Nonces: Gnonce0 ~ Gnonce1
        PRF: Gprf0 ~ Gprf1 
        XOR: Gxor0 ~ Gxor1
    }

    gamehops {
        equivalence Gcpa Hybrid0_b_0 {
            invariant: [
                ./theorem/invariant-Gcpa-Hybrid0_b_0.smt2
            ]
            Enc: {
                randomness: custom
            }
        }
        reduction Hybrid0_b_0 Hybrid0_b_1 {
            assumption PRF
            map Gprf0 Hybrid0_b_0 {
                Prf: Prf
            }
            map Gprf1 Hybrid0_b_1 {
                Prf: Prf
            }
        }
        equivalence Hybrid0_b_1 Hybrid1_b_0 {
            invariant: [
                ./theorem/invariant-Hybrid0_b_1-Hybrid1_b_0.smt2
            ]
            Enc: {
                randomness: custom
            }
        }
        reduction Hybrid1_b_0 Hybrid1_b_1 {
            assumption Nonces
            map Gnonce0 Hybrid1_b_0 {
                Nonce: Nonce
            }
            map Gnonce1 Hybrid1_b_1 {
                Nonce: Nonce
            }
        }
        equivalence Hybrid1_b_1 Hybrid2_b_0 {
            invariant: [
                ./theorem/invariant-Hybrid1_b_1-Hybrid2_b_0.smt2
            ]
            Enc: {
                randomness: custom
            }
        }
        reduction Hybrid2_b_0 Hybrid2_b_1 {
            assumption XOR
            map Gxor0 Hybrid2_b_0 {
                Xor: Xor
            }
            map Gxor1 Hybrid2_b_1 {
                Xor: Xor
            }
        }
        equivalence Hybrid2_0_1 Hybrid2_1_1 {
            invariant: [
                ./theorem/invariant-Hybrid2_0_1-Hybrid2_1_1.smt2
            ]
            Enc: {
                randomness: simple
            }
        }
    }
    propositions {
        Main: Gcpa0 ~ Gcpa1
    }
}