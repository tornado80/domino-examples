theorem PrfImpliesIndCpa {
    const b: Bool;
    const prf: fn Bits(256), Bits(256) -> Bits(256);
    const xor: fn Bits(256), Bits(256) -> Bits(256);
    
    instance Gnonce0 = Gnonce {
        params {
            b: false
        }
    }

    instance Gnonce1 = Gnonce {
        params {
            b: true
        }
    }

    instance Gprf0 = Gprf {
        params {
            b: false,
            prf: prf
        }
    }

    instance Gprf1 = Gprf {
        params {
            b: true,
            prf: prf
        }
    }

    instance Gxor0 = Gxor {
        params {
            b: false,
            xor: xor
        }
    }

    instance Gxor1 = Gxor {
        params {
            b: true,
            xor: xor
        }
    }

    instance Gcpa = Gcpa {
        params {
            b: b,
            prf: prf,
            xor: xor
        }
    }

    instance Gcpa0 = Gcpa {
        params {
            b: false,
            prf: prf,
            xor: xor
        }
    }

    instance Gcpa1 = Gcpa {
        params {
            b: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid0 = Hybrid0 {
        params {
            b: b,
            bprf: false,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid1 = Hybrid0 {
        params {
            b: b,
            bprf: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid2 = Hybrid1 {
        params {
            b: b,
            bnonce: false,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid3 = Hybrid1 {
        params {
            b: b,
            bnonce: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid4 = Hybrid2 {
        params {
            b: b,
            bxor: false,
            bnonce: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid5 = Hybrid2 {
        params {
            b: b,
            bxor: true,
            bnonce: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid5_0 = Hybrid2 {
        params {
            b: false,
            bxor: true,
            bnonce: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid5_1 = Hybrid2 {
        params {
            b: true,
            bxor: true,
            bnonce: true,
            prf: prf,
            xor: xor
        }
    }

    assumptions {
        Nonces: Gnonce0 ~ Gnonce1
        PRF: Gprf0 ~ Gprf1 
        XOR: Gxor0 ~ Gxor1
    }

    gamehops {
        equivalence Gcpa Hybrid0 {
            invariant: [
                ./theorem/invariant-Gcpa-Hybrid0.smt2
            ]
            Enc: {
                randomness: custom
            }
        }
        reduction Hybrid0 Hybrid1 {
            assumption PRF
            map Gprf0 Hybrid0 {
                Prf: Prf
            }
            map Gprf1 Hybrid1 {
                Prf: Prf
            }
        }
        equivalence Hybrid1 Hybrid2 {
            invariant: [
                ./theorem/invariant-Hybrid1-Hybrid2.smt2
            ]
            Enc: {
                randomness: custom
            }
        }
        reduction Hybrid2 Hybrid3 {
            assumption Nonces
            map Gnonce0 Hybrid2 {
                Nonce: Nonce
            }
            map Gnonce1 Hybrid3 {
                Nonce: Nonce
            }
        }
        equivalence Hybrid3 Hybrid4 {
            invariant: [
                ./theorem/invariant-Hybrid3-Hybrid4.smt2
            ]
            Enc: {
                randomness: custom
            }
        }
        reduction Hybrid4 Hybrid5 {
            assumption XOR
            map Gxor0 Hybrid4 {
                Xor: Xor
            }
            map Gxor1 Hybrid5 {
                Xor: Xor
            }
        }
        equivalence Hybrid5_0 Hybrid5_1 {
            invariant: [
                ./theorem/invariant-Hybrid5_0-Hybrid5_1.smt2
            ]
            Enc: {
                randomness: simple
            }
        }
    }
    propositions {
        Main: Gcpa0 ~ Gcpa1
    }
}