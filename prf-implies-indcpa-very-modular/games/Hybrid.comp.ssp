composition Hybrid {
    const bmsg: Bool;
    const bprf: Bool;
    const bnonce: Bool;
    const bxor: Bool;
    const bmod: Bool;
    const prf: fn Bits(256), Bits(256) -> Bits(256);
    const xor: fn Bits(256), Bits(256) -> Bits(256);

    instance Prf = PRF {
        params {
            bprf: bprf,
            prf: prf
        }
    }

    instance Nonce = Nonce {
        params {
            bnonce: bnonce
        }
    }

    instance Xor = XOR {
        params {
            bxor: bxor,
            xor: xor
        }
    }

    instance Message = Message {
        params {
            bmsg: bmsg,
        }
    }

    instance Reduction = Reduction {
        params {
            bmod: bmod,
            xor: xor
        }
    }

    compose {
        adversary: {
            Enc: Reduction
        }
        Reduction: {
            GetMessage: Message,
            Sample: Nonce,
            Eval: Prf,
            Xor: Xor
        }
    }
}
