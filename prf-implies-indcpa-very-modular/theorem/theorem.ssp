theorem PrfImpliesIndCpaVeryModular {
    const b: Bool;
    const prf: fn Bits(256), Bits(256) -> Bits(256);
    const xor: fn Bits(256), Bits(256) -> Bits(256);
    
    instance Gnonce0 = Gnonce {
        params {
            bnonce: false
        }
    }

    instance Gnonce1 = Gnonce {
        params {
            bnonce: true
        }
    }

    instance Gprf0 = Gprf {
        params {
            bprf: false,
            prf: prf
        }
    }

    instance Gprf1 = Gprf {
        params {
            bprf: true,
            prf: prf
        }
    }

    instance Gxor0 = Gxor {
        params {
            bxor: false,
            xor: xor
        }
    }

    instance Gxor1 = Gxor {
        params {
            bxor: true,
            xor: xor
        }
    }

    instance Gcpa = Gcpa {
        params {
            bcpa: b,
            prf: prf,
            xor: xor
        }
    }

    instance Gcpa0 = Gcpa {
        params {
            bcpa: false,
            prf: prf,
            xor: xor
        }
    }

    instance Gcpa1 = Gcpa {
        params {
            bcpa: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid_b_0_0_0_0 = Hybrid {
        params {
            bmsg: b,
            bprf: false,
            bnonce: false,
            bxor: false,
            bmod: false,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid_b_1_0_0_0 = Hybrid {
        params {
            bmsg: b,
            bprf: true,
            bnonce: false,
            bxor: false,
            bmod: false,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid_b_1_1_0_0 = Hybrid {
        params {
            bmsg: b,
            bprf: true,
            bnonce: true,
            bxor: false,
            bmod: false,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid_b_1_1_0_1 = Hybrid {
        params {
            bmsg: b,
            bprf: true,
            bnonce: true,
            bxor: false,
            bmod: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid_b_1_1_1_1 = Hybrid {
        params {
            bmsg: b,
            bprf: true,
            bnonce: true,
            bxor: true,
            bmod: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid_0_1_1_1_1 = Hybrid {
        params {
            bmsg: false,
            bprf: true,
            bnonce: true,
            bxor: true,
            bmod: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid_1_1_1_1_1 = Hybrid {
        params {
            bmsg: true,
            bprf: true,
            bnonce: true,
            bxor: true,
            bmod: true,
            prf: prf,
            xor: xor
        }
    }

    assumptions {
        Nonces: Gnonce0 ~ Gnonce1
        PRF: Gprf0 ~ Gprf1 
        XOR: Gxor0 ~ Gxor1
    }

    gamehops {
        equivalence Gcpa Hybrid_b_0_0_0_0 {
            invariant: [
                ./theorem/invariant-Gcpa-Hybrid_b_0_0_0_0.smt2
            ]
            Enc: {
                randomness: custom
            }
        }
        reduction Hybrid_b_0_0_0_0 Hybrid_b_1_0_0_0 {
            assumption PRF
            map Gprf0 Hybrid_b_0_0_0_0 {
                Prf: Prf
            }
            map Gprf1 Hybrid_b_1_0_0_0 {
                Prf: Prf
            }
        }
        reduction Hybrid_b_1_0_0_0 Hybrid_b_1_1_0_0 {
            assumption Nonces
            map Gnonce0 Hybrid_b_1_0_0_0 {
                Nonce: Nonce
            }
            map Gnonce1 Hybrid_b_1_1_0_0 {
                Nonce: Nonce
            }
        }
        equivalence Hybrid_b_1_1_0_0 Hybrid_b_1_1_0_1 {
            invariant: [
                ./theorem/invariant-Hybrid_b_1_1_0_0-Hybrid_b_1_1_0_1.smt2
            ]
            Enc: {
                randomness: custom
            }
        }
        reduction Hybrid_b_1_1_0_1 Hybrid_b_1_1_1_1 {
            assumption XOR
            map Gxor0 Hybrid_b_1_1_0_1 {
                Xor: Xor
            }
            map Gxor1 Hybrid_b_1_1_1_1 {
                Xor: Xor
            }
        }
        equivalence Hybrid_0_1_1_1_1 Hybrid_1_1_1_1_1 {
            invariant: [
                ./theorem/invariant-Hybrid_0_1_1_1_1-Hybrid_1_1_1_1_1.smt2
            ]
            Enc: {
                randomness: simple
            }
        }
    }
    propositions {
        Main: Gcpa0 ~ Gcpa1
    }
}