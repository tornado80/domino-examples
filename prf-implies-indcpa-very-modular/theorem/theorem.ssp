theorem PrfImpliesIndCpaVeryModular {
    const b: Bool;
    const prf: fn Bits(256), Bits(256) -> Bits(256);
    const xor: fn Bits(256), Bits(256) -> Bits(256);
    
    instance Gnonce_0 = Gnonce {
        params {
            bnonce: false
        }
    }

    instance Gnonce_1 = Gnonce {
        params {
            bnonce: true
        }
    }

    instance Gprf_0 = Gprf {
        params {
            bprf: false,
            prf: prf
        }
    }

    instance Gprf_1 = Gprf {
        params {
            bprf: true,
            prf: prf
        }
    }

    instance Gxor_0 = Gxor {
        params {
            bxor: false,
            xor: xor
        }
    }

    instance Gxor_1 = Gxor {
        params {
            bxor: true,
            xor: xor
        }
    }

    instance Gcpa_b = Gcpa {
        params {
            bcpa: b,
            prf: prf,
            xor: xor
        }
    }

    instance Gcpa_0 = Gcpa {
        params {
            bcpa: false,
            prf: prf,
            xor: xor
        }
    }

    instance Gcpa_1 = Gcpa {
        params {
            bcpa: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid_b_0_0_0_0 = Hybrid {
        params {
            bmsg: b,
            bprf: false,
            bnonce: false,
            bxor: false,
            bmod: false,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid_b_1_0_0_0 = Hybrid {
        params {
            bmsg: b,
            bprf: true,
            bnonce: false,
            bxor: false,
            bmod: false,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid_b_1_1_0_0 = Hybrid {
        params {
            bmsg: b,
            bprf: true,
            bnonce: true,
            bxor: false,
            bmod: false,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid_b_1_1_0_1 = Hybrid {
        params {
            bmsg: b,
            bprf: true,
            bnonce: true,
            bxor: false,
            bmod: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid_b_1_1_1_1 = Hybrid {
        params {
            bmsg: b,
            bprf: true,
            bnonce: true,
            bxor: true,
            bmod: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid_0_1_1_1_1 = Hybrid {
        params {
            bmsg: false,
            bprf: true,
            bnonce: true,
            bxor: true,
            bmod: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid_1_1_1_1_1 = Hybrid {
        params {
            bmsg: true,
            bprf: true,
            bnonce: true,
            bxor: true,
            bmod: true,
            prf: prf,
            xor: xor
        }
    }

    assumptions {
        Nonces: Gnonce_0 ~ Gnonce_1
        PRF: Gprf_0 ~ Gprf_1 
        XOR: Gxor_0 ~ Gxor_1
    }

    gamehops {
        equivalence Gcpa_b Hybrid_b_0_0_0_0 {
            invariant: [
                ./theorem/invariant-Gcpa_b-Hybrid_b_0_0_0_0.smt2
            ]
            Enc: {
                randomness: custom
            }
        }
        reduction Hybrid_b_0_0_0_0 Hybrid_b_1_0_0_0 {
            assumption PRF
            map Gprf_0 Hybrid_b_0_0_0_0 {
                PRF: PRF
            }
            map Gprf_1 Hybrid_b_1_0_0_0 {
                PRF: PRF
            }
        }
        reduction Hybrid_b_1_0_0_0 Hybrid_b_1_1_0_0 {
            assumption Nonces
            map Gnonce_0 Hybrid_b_1_0_0_0 {
                Nonce: Nonce
            }
            map Gnonce_1 Hybrid_b_1_1_0_0 {
                Nonce: Nonce
            }
        }
        equivalence Hybrid_b_1_1_0_0 Hybrid_b_1_1_0_1 {
            invariant: [
                ./theorem/invariant-Hybrid_b_1_1_0_0-Hybrid_b_1_1_0_1.smt2
            ]
            Enc: {
                randomness: custom
            }
        }
        reduction Hybrid_b_1_1_0_1 Hybrid_b_1_1_1_1 {
            assumption XOR
            map Gxor_0 Hybrid_b_1_1_0_1 {
                XOR: XOR
            }
            map Gxor_1 Hybrid_b_1_1_1_1 {
                XOR: XOR
            }
        }
        equivalence Hybrid_0_1_1_1_1 Hybrid_1_1_1_1_1 {
            invariant: [
                ./theorem/invariant-Hybrid_0_1_1_1_1-Hybrid_1_1_1_1_1.smt2
            ]
            Enc: {
                randomness: simple
            }
        }
    }
    propositions {
        Main: Gcpa_0 ~ Gcpa_1
    }
}