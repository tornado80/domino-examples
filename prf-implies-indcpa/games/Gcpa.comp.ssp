composition Gcpa {
    const bcpa: Bool;
    const prf: fn Bits(256), Bits(256) -> Bits(256);
    const xor: fn Bits(256), Bits(256) -> Bits(256);

    instance Construction = Construction {
        params {
            prf: prf,
            xor: xor
        }
    }

    instance CPA = CPA {
        params {
            prf: prf,
            bcpa: bcpa
        }
    }

    compose {
        adversary: {
            Enc: CPA
        }
        CPA: {
            Enc: Construction,
        }
    }
}