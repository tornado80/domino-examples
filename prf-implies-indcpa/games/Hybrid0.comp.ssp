composition Hybrid0 {
    const bmsg: Bool;
    const bprf: Bool;
    const prf: fn Bits(256), Bits(256) -> Bits(256);
    const xor: fn Bits(256), Bits(256) -> Bits(256);

    instance Prf = PRF {
        params {
            bprf: bprf,
            prf: prf
        }
    }

    instance Reduction1 = Reduction1 {
        params {
            xor: xor,
            bmsg: bmsg
        }
    }

    compose {
        adversary: {
            Enc: Reduction1
        }
        Reduction1: {
            Eval: Prf,
        }
    }
}