composition Hybrid1 {
    const bnonce: Bool;
    const bmsg: Bool;
    const prf: fn Bits(256), Bits(256) -> Bits(256);
    const xor: fn Bits(256), Bits(256) -> Bits(256);

    instance Nonce = Nonce {
        params {
            bnonce: bnonce
        }
    }

    instance Reduction2 = Reduction2 {
        params {
            xor: xor,
            bmsg: bmsg
        }
    }

    compose {
        adversary: {
            Enc: Reduction2
        }
        Reduction2: {
            Sample: Nonce
        }
    }
}