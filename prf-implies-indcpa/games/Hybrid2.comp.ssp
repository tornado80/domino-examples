composition Hybrid2 {
    const bmsg: Bool;
    const bxor: Bool;
    const prf: fn Bits(256), Bits(256) -> Bits(256);
    const xor: fn Bits(256), Bits(256) -> Bits(256);

    instance Xor = XOR {
        params {
            bxor: bxor,
            xor: xor
        }
    }

    instance Reduction3 = Reduction3 {
        params {
            bmsg: bmsg
        }
    }

    compose {
        adversary: {
            Enc: Reduction3
        }
        Reduction3: {
            Xor: Xor,
        }
    }
}