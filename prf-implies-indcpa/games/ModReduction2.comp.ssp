composition ModReduction2 {
    const bcoll: Bool;
    const b: Bool;
    const prf: fn Bits(256), Bits(256) -> Bits(256);
    const xor: fn Bits(256), Bits(256) -> Bits(256);

    instance Coll = Coll {
        params {
            b: bcoll
        }
    }

    instance Message = Message {
        params {
            b: b,
        }
    }

    instance Reduction2 = Reduction2 {
        params {
            xor: xor
        }
    }

    compose {
        adversary: {
            ENC: Reduction2
        }
        Reduction2: {
            GET_MSG: Message,
            GET: Coll
        }
    }
}