package Reduction2 {
    import oracles {
        GET_MSG(m: Bits(256)) -> Bits(256),
        GET() -> Bits(256),
    }

    params {
        xor: fn Bits(256), Bits(256) -> Bits(256)
    }

    state {
        T: Table(Bits(256), Bits(256))
    }

    oracle ENC(m: Bits(256)) -> (Bits(256), Bits(256)) {
        r <- invoke GET();
        m <- invoke GET_MSG(m);
        if (T[r] == None) {
            pad <-$ Bits(256) sample-name pad;
            T[r] <- Some(pad);
        }
        return (r, xor(Unwrap(T[r]), m));
    }
}