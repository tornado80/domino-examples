package Reduction2 {
    import oracles {
        Sample() -> Bits(256),
    }

    params {
        bmsg: Bool,
        xor: fn Bits(256), Bits(256) -> Bits(256)
    }

    state {
        T: Table(Bits(256), Bits(256))
    }

    oracle Enc(m: Bits(256)) -> (Bits(256), Bits(256)) {
        nonce <- invoke Sample();
        if bmsg {
            m <- 0_256;
        }
        if (T[nonce] == None) {
            pad <-$ Bits(256) sample-name pad;
            T[nonce] <- Some(pad);
        }
        return (nonce, xor(Unwrap(T[nonce]), m));
    }
}