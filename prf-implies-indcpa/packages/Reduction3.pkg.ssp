package Reduction3 {
    import oracles {
        Xor(m: Bits(256)) -> Bits(256),
    }

    params {
        b: Bool
    }

    state {
        T: Table(Bits(256), Bool)
    }

    oracle Enc(m: Bits(256)) -> (Bits(256), Bits(256)) {
        nonce <-$ Bits(256) sample-name nonce;
        assert (T[nonce] == None);
        T[nonce] <- Some(true);
        if b {
            m <- 0_256;
        }
        c <- invoke Xor(m);
        return (nonce, c);
    }
}