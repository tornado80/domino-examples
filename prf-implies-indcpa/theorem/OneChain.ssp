theorem OneChain {
    const b: Bool;
    const prf: fn Bits(256), Bits(256) -> Bits(256);
    const xor: fn Bits(256), Bits(256) -> Bits(256);
    
    instance Gnonce0 = Gnonce {
        params {
            b: false
        }
    }

    instance Gnonce1 = Gnonce {
        params {
            b: true
        }
    }

    instance Gprf0 = Gprf {
        params {
            b: false,
            prf: prf
        }
    }

    instance Gprf1 = Gprf {
        params {
            b: true,
            prf: prf
        }
    }

    instance Gxor0 = Gxor {
        params {
            b: false,
            xor: xor
        }
    }

    instance Gxor1 = Gxor {
        params {
            b: true,
            xor: xor
        }
    }

    instance Gcpa = Gcpa {
        params {
            b: b,
            prf: prf,
            xor: xor
        }
    }

    instance Gcpa0 = Gcpa {
        params {
            b: false,
            prf: prf,
            xor: xor
        }
    }

    instance Gcpa1 = Gcpa {
        params {
            b: true,
            prf: prf,
            xor: xor
        }
    }

    instance Gmod0 = ModReduction1 {
        params {
            b: b,
            bprf: false,
            prf: prf,
            xor: xor
        }
    }

    instance Gmod1 = ModReduction1 {
        params {
            b: b,
            bprf: true,
            prf: prf,
            xor: xor
        }
    }

    instance Gmod2 = ModReduction2 {
        params {
            b: b,
            bnonce: false,
            prf: prf,
            xor: xor
        }
    }

    instance Gmod3 = ModReduction2 {
        params {
            b: b,
            bnonce: true,
            prf: prf,
            xor: xor
        }
    }

    instance Gmod4 = ModReduction3 {
        params {
            b: b,
            bxor: false,
            bnonce: true,
            prf: prf,
            xor: xor
        }
    }

    instance Gmod5 = ModReduction3 {
        params {
            b: b,
            bxor: true,
            bnonce: true,
            prf: prf,
            xor: xor
        }
    }

    instance Gmod5_0 = ModReduction3 {
        params {
            b: false,
            bxor: true,
            bnonce: true,
            prf: prf,
            xor: xor
        }
    }

    instance Gmod5_1 = ModReduction3 {
        params {
            b: true,
            bxor: true,
            bnonce: true,
            prf: prf,
            xor: xor
        }
    }

    assumptions {
        Nonces: Gnonce0 ~ Gnonce1
        PRF: Gprf0 ~ Gprf1 
        XOR: Gxor0 ~ Gxor1
    }

    gamehops {
        equivalence Gcpa Gmod0 {
            invariant: [
                ./theorem/invariant-Gcpa-Gmod0.smt2
            ]
            Enc: {
                randomness: custom
            }
        }
        reduction Gmod0 Gmod1 {
            assumption PRF
            map Gprf0 Gmod0 {
                Prf: Prf
            }
            map Gprf1 Gmod1 {
                Prf: Prf
            }
        }
        equivalence Gmod1 Gmod2 {
            invariant: [
                ./theorem/invariant-Gmod1-Gmod2.smt2
            ]
            Enc: {
                randomness: custom
            }
        }
        reduction Gmod2 Gmod3 {
            assumption Nonces
            map Gnonce0 Gmod2 {
                Nonce: Nonce
            }
            map Gnonce1 Gmod3 {
                Nonce: Nonce
            }
        }
        equivalence Gmod3 Gmod4 {
            invariant: [
                ./theorem/invariant-Gmod3-Gmod4.smt2
            ]
            Enc: {
                randomness: custom
            }
        }
        reduction Gmod4 Gmod5 {
            assumption XOR
            map Gxor0 Gmod4 {
                Xor: Xor
            }
            map Gxor1 Gmod5 {
                Xor: Xor
            }
        }
        equivalence Gmod5_0 Gmod5_1 {
            invariant: [
                ./theorem/invariant-Gmod5Real-Gmod5Ideal.smt2
            ]
            Enc: {
                randomness: simple
            }
        }
    }
    propositions {
        Main: Gcpa0 ~ Gcpa1
    }
}