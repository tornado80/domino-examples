theorem TwoChains {
    const prf: fn Bits(256), Bits(256) -> Bits(256);
    const xor: fn Bits(256), Bits(256) -> Bits(256);
    
    instance Gnonce0 = Gnonce {
        params {
            b: false
        }
    }

    instance Gnonce1 = Gnonce {
        params {
            b: true
        }
    }

    instance Gprf0 = Gprf {
        params {
            b: false,
            prf: prf
        }
    }

    instance Gprf1 = Gprf {
        params {
            b: true,
            prf: prf
        }
    }

    instance Gxor0 = Gxor {
        params {
            b: false,
            xor: xor
        }
    }

    instance Gxor1 = Gxor {
        params {
            b: true,
            xor: xor
        }
    }

    instance Gcpa0 = Gcpa {
        params {
            b: false,
            prf: prf,
            xor: xor
        }
    }

    instance Gcpa1 = Gcpa {
        params {
            b: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid0_0 = Hybrid0 {
        params {
            b: false,
            bprf: false,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid0_1 = Hybrid0 {
        params {
            b: true,
            bprf: false,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid1_0 = Hybrid0 {
        params {
            b: false,
            bprf: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid1_1 = Hybrid0 {
        params {
            b: true,
            bprf: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid2_0 = Hybrid1 {
        params {
            b: false,
            bnonce: false,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid2_1 = Hybrid1 {
        params {
            b: true,
            bnonce: false,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid3_0 = Hybrid1 {
        params {
            b: false,
            bnonce: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid3_1 = Hybrid1 {
        params {
            b: true,
            bnonce: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid4_0 = Hybrid2 {
        params {
            b: false,
            bxor: false,
            bnonce: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid4_1 = Hybrid2 {
        params {
            b: true,
            bxor: false,
            bnonce: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid5_0 = Hybrid2 {
        params {
            b: false,
            bxor: true,
            bnonce: true,
            prf: prf,
            xor: xor
        }
    }

    instance Hybrid5_1 = Hybrid2 {
        params {
            b: true,
            bxor: true,
            bnonce: true,
            prf: prf,
            xor: xor
        }
    }

    assumptions {
        Nonces: Gnonce0 ~ Gnonce1
        PRF: Gprf0 ~ Gprf1 
        XOR: Gxor0 ~ Gxor1
    }

    gamehops {
        equivalence Gcpa0 Hybrid0_0 {
            invariant: [
                ./theorem/invariant-Gcpa-Hybrid0.smt2
            ]
            Enc: {
                randomness: custom
            }
        }
        equivalence Gcpa1 Hybrid0_1 {
            invariant: [
                ./theorem/invariant-Gcpa-Hybrid0.smt2
            ]
            Enc: {
                randomness: custom
            }
        }
        reduction Hybrid0_0 Hybrid1_0 {
            assumption PRF
            map Gprf0 Hybrid0_0 {
                Prf: Prf
            }
            map Gprf1 Hybrid1_0 {
                Prf: Prf
            }
        }
        reduction Hybrid0_1 Hybrid1_1 {
            assumption PRF
            map Gprf0 Hybrid0_1 {
                Prf: Prf
            }
            map Gprf1 Hybrid1_1 {
                Prf: Prf
            }
        }
        equivalence Hybrid1_0 Hybrid2_0 {
            invariant: [
                ./theorem/invariant-Hybrid1-Hybrid2.smt2
            ]
            Enc: {
                randomness: custom
            }
        }
        equivalence Hybrid1_1 Hybrid2_1 {
            invariant: [
                ./theorem/invariant-Hybrid1-Hybrid2.smt2
            ]
            Enc: {
                randomness: custom
            }
        }
        reduction Hybrid2_0 Hybrid3_0 {
            assumption Nonces
            map Gnonce0 Hybrid2_0 {
                Nonce: Nonce
            }
            map Gnonce1 Hybrid3_0 {
                Nonce: Nonce
            }
        }
        reduction Hybrid2_1 Hybrid3_1 {
            assumption Nonces
            map Gnonce0 Hybrid2_1 {
                Nonce: Nonce
            }
            map Gnonce1 Hybrid3_1 {
                Nonce: Nonce
            }
        }
        equivalence Hybrid3_0 Hybrid4_0 {
            invariant: [
                ./theorem/invariant-Hybrid3-Hybrid4.smt2
            ]
            Enc: {
                randomness: custom
            }
        }
        equivalence Hybrid3_1 Hybrid4_1 {
            invariant: [
                ./theorem/invariant-Hybrid3-Hybrid4.smt2
            ]
            Enc: {
                randomness: custom
            }
        }
        reduction Hybrid4_0 Hybrid5_0 {
            assumption XOR
            map Gxor0 Hybrid4_0 {
                Xor: Xor
            }
            map Gxor1 Hybrid5_0 {
                Xor: Xor
            }
        }
        reduction Hybrid4_1 Hybrid5_1 {
            assumption XOR
            map Gxor0 Hybrid4_1 {
                Xor: Xor
            }
            map Gxor1 Hybrid5_1 {
                Xor: Xor
            }
        }
        equivalence Hybrid5_0 Hybrid5_1 {
            invariant: [
                ./theorem/invariant-Hybrid5_0-Hybrid5_1.smt2
            ]
            Enc: {
                randomness: simple
            }
        }
    }
    propositions {
        Main: Gcpa0 ~ Gcpa1
    }
}